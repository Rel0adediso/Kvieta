<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <Platform>x64</Platform>
    <InstallerPlatform>x64</InstallerPlatform>
    <OtiumVersion Condition="'$(OtiumVersion)' == ''">0.18.0</OtiumVersion>
    <OtiumPublishDir Condition="'$(OtiumPublishDir)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\publish\win-x64</OtiumPublishDir>
    <OtiumSignerThumbprint Condition="'$(OtiumSignerThumbprint)' == ''">UNSIGNED-DEVELOPMENT-BUILD</OtiumSignerThumbprint>
    <DefineConstants>OtiumVersion=$(OtiumVersion);OtiumPublishDir=$(OtiumPublishDir);OtiumSignerThumbprint=$(OtiumSignerThumbprint)</DefineConstants>
    <OutputName>Otium-$(OtiumVersion)-win-x64</OutputName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
  </ItemGroup>
</Project>
