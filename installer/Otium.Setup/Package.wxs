<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
    Name="Otium"
    Manufacturer="Otium"
    Version="$(var.OtiumVersion)"
    UpgradeCode="B7DB180A-83DE-4B93-A8FB-453734F91C10"
    Language="1033"
    Codepage="65001"
    Scope="perMachine">

    <SummaryInformation Description="Otium local screen-time awareness and control" />
    <MajorUpgrade
      DowngradeErrorMessage="A newer version of Otium is already installed." />
    <!-- Otium.exe is already a compressed single-file bundle. MSZIP keeps the MSI
         self-contained without applying the much slower default LZX recompression. -->
    <MediaTemplate EmbedCab="yes" CompressionLevel="mszip" />

    <Property Id="ARPNOREMOVE" Value="1" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property
      Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT"
      Value="Kurulum bitince Otium'u aç" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />

    <CustomAction
      Id="LaunchOtiumAfterInstall"
      FileRef="OtiumExecutable"
      ExeCommand=""
      Execute="immediate"
      Impersonate="yes"
      Return="asyncNoWait" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Otium" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="MainFeature" Title="Otium" Level="1">
      <ComponentRef Id="OtiumExecutableComponent" />
    </Feature>
    <Feature
      Id="DesktopShortcutFeature"
      Title="Desktop shortcut"
      Description="Create an Otium shortcut on the desktop"
      Level="2">
      <ComponentRef Id="DesktopShortcutComponent" />
    </Feature>

    <ui:WixUI Id="WixUI_FeatureTree" />
    <UI>
      <Publish
        Dialog="ExitDialog"
        Control="Finish"
        Event="DoAction"
        Value="LaunchOtiumAfterInstall"
        Order="1"
        Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>

    <Component Id="OtiumExecutableComponent" Directory="INSTALLFOLDER" Guid="*">
      <File Id="OtiumExecutable" Source="$(var.OtiumPublishDir)\Otium.exe" KeyPath="yes">
        <Shortcut
          Id="StartMenuShortcut"
          Directory="ProgramMenuFolder"
          Name="Otium"
          Description="Otium"
          WorkingDirectory="INSTALLFOLDER"
          Advertise="yes" />
        <Shortcut
          Id="UninstallShortcut"
          Directory="ProgramMenuFolder"
          Name="Otium'u Kaldır"
          Description="Otium'u güvenli biçimde kaldır"
          Arguments="--uninstall"
          WorkingDirectory="INSTALLFOLDER"
          Advertise="yes" />
      </File>
      <ServiceInstall
        Id="GuardianServiceInstall"
        Name="OtiumGuardian"
        DisplayName="Otium Protection"
        Description="Otium protected-session watchdog"
        Type="ownProcess"
        Start="auto"
        ErrorControl="normal"
        Arguments="--guardian-service" />
      <ServiceControl
        Id="GuardianServiceControl"
        Name="OtiumGuardian"
        Start="install"
        Stop="both"
        Remove="uninstall"
        Wait="yes" />
      <RegistryValue
        Root="HKLM"
        Key="Software\Otium"
        Name="InstallerManaged"
        Type="integer"
        Value="1" />
      <RegistryValue
        Root="HKLM"
        Key="Software\Otium"
        Name="ProductCode"
        Type="string"
        Value="[ProductCode]" />
      <RegistryValue
        Root="HKLM"
        Key="Software\Otium"
        Name="InstalledVersion"
        Type="string"
        Value="[ProductVersion]" />
      <RegistryValue
        Root="HKLM"
        Key="Software\Otium"
        Name="SignerThumbprint"
        Type="string"
        Value="$(var.OtiumSignerThumbprint)" />
    </Component>

    <Component
      Id="DesktopShortcutComponent"
      Directory="INSTALLFOLDER"
      Guid="*">
      <Shortcut
        Id="DesktopShortcut"
        Directory="DesktopFolder"
        Name="Otium"
        Description="Otium"
        Target="[INSTALLFOLDER]Otium.exe"
        WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue
        Root="HKCU"
        Key="Software\Otium"
        Name="DesktopShortcut"
        Type="integer"
        Value="1"
        KeyPath="yes" />
    </Component>
  </Package>
</Wix>
