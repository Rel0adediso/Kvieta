<Window x:Class="KardesKilidi.App.CafeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Otium · Oturum" WindowStyle="None" WindowState="Maximized" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="True" Loaded="Window_Loaded" Closing="Window_Closing" Closed="Window_Closed" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid Margin="42,30">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Border Width="36" Height="36" Background="{DynamicResource PrimaryBrush}" CornerRadius="9"><TextBlock Text="O" Foreground="{DynamicResource PrimaryForegroundBrush}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center"><TextBlock Text="Otium" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource DailyRhythm}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,2,0,0" /></StackPanel>
                </StackPanel>
                <Button x:Name="ExitButton" Content="{DynamicResource ExitPreview}" HorizontalAlignment="Right" Style="{StaticResource SecondaryButtonStyle}" Padding="14,7" Click="ExitPrototype_Click" />
            </Grid>

            <StackPanel Grid.Row="1" Width="560" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Background="{DynamicResource PrimarySoftBrush}" CornerRadius="6" Padding="12,6" HorizontalAlignment="Center"><TextBlock Text="{Binding StateLabel}" Foreground="{DynamicResource PrimaryBrush}" FontSize="11" FontWeight="SemiBold" /></Border>
                <TextBlock Text="{Binding Headline}" FontSize="32" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,22,0,8" />
                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedTextBrush}" FontSize="14" TextAlignment="Center" TextWrapping="Wrap" />
                <Border Background="{DynamicResource WarningSoftBrush}" CornerRadius="6" Padding="12,7" HorizontalAlignment="Center" Margin="0,12,0,0" Visibility="{Binding IsBlocked, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="{Binding BlockedReasonText}" Foreground="{DynamicResource WarningBrush}" FontSize="12" FontWeight="SemiBold" TextAlignment="Center" /></Border>
                <TextBlock Text="{DynamicResource OutsideScheduleHint}" Foreground="{DynamicResource WarningBrush}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding IsOutsideSchedule, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Text="{DynamicResource RemainingTimeLong}" Foreground="{DynamicResource FaintTextBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,34,0,8" />
                <TextBlock Text="{Binding RemainingText}" FontSize="68" FontWeight="Light" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding PauseDurationText}" Foreground="{DynamicResource PrimaryBrush}" FontSize="13" HorizontalAlignment="Center" Margin="0,7,0,0" />
                <ProgressBar Value="{Binding UsagePercent, Mode=OneWay}" Maximum="100" Width="500" Margin="0,26,0,9" />
                <Grid Width="500"><TextBlock Text="{Binding UsedDisplayText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" /><TextBlock Text="{Binding LimitDisplayText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" HorizontalAlignment="Right" /></Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,32,0,0">
                    <Button Content="{Binding PrimaryActionText}" Style="{StaticResource PrimaryButtonStyle}" Visibility="{Binding CanStartOrResume, Converter={StaticResource BooleanToVisibilityConverter}}" Click="StartOrResume_Click" Margin="0,0,8,0" />
                    <Button Content="{DynamicResource EndSession}" Style="{StaticResource SecondaryButtonStyle}" Visibility="{Binding CanEndSession, Converter={StaticResource BooleanToVisibilityConverter}}" Click="EndSession_Click" Margin="0,0,8,0" />
                    <Button Content="{DynamicResource RequestTime}" Style="{StaticResource SecondaryButtonStyle}" Visibility="{Binding CanRequestExtraTime, Converter={StaticResource BooleanToVisibilityConverter}}" Click="RequestTime_Click" Margin="0,0,8,0" />
                    <Button Content="{DynamicResource DevicePower}" Style="{StaticResource SecondaryButtonStyle}" Click="PowerMenu_Click" />
                </StackPanel>
            </StackPanel>
            <TextBlock Grid.Row="2" Text="{DynamicResource BreakHint}" Foreground="{DynamicResource FaintTextBrush}" FontSize="11" HorizontalAlignment="Center" />
        </Grid>

        <Border x:Name="PowerOverlay" Background="{DynamicResource OverlayBrush}" Visibility="Collapsed">
            <Border Style="{StaticResource CardStyle}" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <StackPanel><TextBlock Text="{DynamicResource DeviceOptions}" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource PowerSaveHint}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,6,0,20" />
                    <Button Content="{DynamicResource Sleep}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,8" Click="Sleep_Click" /><Button Content="{DynamicResource Restart}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,8" Click="Restart_Click" /><Button Content="{DynamicResource Shutdown}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,16" Click="Shutdown_Click" /><Button Content="{DynamicResource Cancel}" Style="{StaticResource PrimaryButtonStyle}" Click="ClosePowerMenu_Click" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
