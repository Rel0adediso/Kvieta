<Window x:Class="KardesKilidi.App.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="238" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Topmost="True"
        Deactivated="Window_Deactivated">
    <Window.Resources>
        <Style x:Key="TrayActionStyle" TargetType="Button">
            <Setter Property="Height" Value="43" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="ActionSurface" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ActionSurface" Property="Background" Value="{DynamicResource PrimarySoftBrush}" /></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="ActionSurface" Property="Opacity" Value="0.72" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Border Margin="10" Padding="9" CornerRadius="12" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="5" Opacity="0.24" /></Border.Effect>
        <StackPanel>
            <Grid Margin="5,3,5,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border Width="29" Height="29" CornerRadius="8" Background="{DynamicResource PrimaryBrush}">
                    <TextBlock Text="O" Foreground="{DynamicResource PrimaryForegroundBrush}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Otium" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource BackgroundActive}" Foreground="{DynamicResource MutedTextBrush}" FontSize="9" Margin="0,2,0,0" />
                </StackPanel>
                <Ellipse Grid.Column="2" Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
            </Grid>
            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="2,0,2,4" />
            <Button Style="{StaticResource TrayActionStyle}" Click="OpenControlCenter_Click">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="25" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="⌂" Foreground="{DynamicResource PrimaryBrush}" FontSize="15" VerticalAlignment="Center" TextAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{DynamicResource ControlCenter}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0" />
                    <TextBlock Grid.Column="2" Text="›" Foreground="{DynamicResource FaintTextBrush}" FontSize="17" VerticalAlignment="Center" />
                </Grid>
            </Button>
            <Button Style="{StaticResource TrayActionStyle}" Click="OpenSessionScreen_Click">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="25" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="◷" Foreground="{DynamicResource PrimaryBrush}" FontSize="15" VerticalAlignment="Center" TextAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{DynamicResource SessionScreen}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0" />
                    <TextBlock Grid.Column="2" Text="›" Foreground="{DynamicResource FaintTextBrush}" FontSize="17" VerticalAlignment="Center" />
                </Grid>
            </Button>
        </StackPanel>
    </Border>
</Window>
