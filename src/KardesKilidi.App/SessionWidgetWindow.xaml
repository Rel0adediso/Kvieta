<Window x:Class="KardesKilidi.App.SessionWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Otium" Width="286" Height="104" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" Background="Transparent" AllowsTransparency="True"
        Closing="Window_Closing" MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center"><TextBlock Text="{DynamicResource OtiumRemaining}" Foreground="{DynamicResource MutedTextBrush}" FontSize="9" FontWeight="SemiBold" /><TextBlock Text="{Binding RemainingText}" FontSize="25" FontWeight="SemiBold" Margin="0,3,0,0" /><TextBlock Text="{DynamicResource TimeRunning}" Foreground="{DynamicResource PrimaryBrush}" FontSize="10" /></StackPanel>
            <Button Grid.Column="1" Content="{DynamicResource Break}" Style="{StaticResource PrimaryButtonStyle}" Padding="13,8" VerticalAlignment="Center" Click="Pause_Click" />
        </Grid>
    </Border>
</Window>
