<Window x:Class="Kvieta.App.BonusTimeWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="390" Height="260" WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="Transparent" AllowsTransparency="True" ShowInTaskbar="False">
    <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14">
        <Grid><Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"><Grid Margin="16,0"><TextBlock Text="Kvieta" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" /><Button Content="×" Width="27" Height="27" Padding="0" HorizontalAlignment="Right" Style="{StaticResource SecondaryButtonStyle}" Click="Cancel_Click" /></Grid></Border>
            <StackPanel Grid.Row="1" Margin="28,24"><TextBlock Text="{DynamicResource GrantExtraTime}" FontSize="21" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource GrantExtraTimeDescription}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,6,0,20" />
                <UniformGrid Columns="3"><Button x:Name="Minutes15" Tag="15" Style="{StaticResource SecondaryButtonStyle}" Click="Select_Click" Margin="0,0,6,0" /><Button x:Name="Minutes30" Tag="30" Style="{StaticResource PrimaryButtonStyle}" Click="Select_Click" Margin="3,0" /><Button x:Name="Minutes60" Tag="60" Style="{StaticResource SecondaryButtonStyle}" Click="Select_Click" Margin="6,0,0,0" /></UniformGrid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
