<Window x:Class="Kvieta.App.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="238" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Topmost="True"
        Deactivated="Window_Deactivated">
    <Window.Resources>
        <Geometry x:Key="TrayHomeIconGeometry">M3,11 L12,3 L21,11 M5.5,9.5 V20 H18.5 V9.5 M9.5,20 V14 H14.5 V20</Geometry>
        <Geometry x:Key="TrayClockIconGeometry">M12,3 A9,9 0 1 1 11.99,3 M12,7 V12 L15.5,14</Geometry>
        <Geometry x:Key="TrayChevronIconGeometry">M8,4 L14,10 L8,16</Geometry>
        <Style x:Key="TrayActionStyle" TargetType="Button">
            <Setter Property="Height" Value="43" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="ActionSurface" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ActionSurface" Property="Background" Value="{DynamicResource PrimarySoftBrush}" /></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="ActionSurface" Property="Opacity" Value="0.72" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Border Margin="10" Padding="9" CornerRadius="12" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="5" Opacity="0.24" /></Border.Effect>
        <StackPanel>
            <Grid Margin="5,3,5,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <ContentControl Width="29" Height="29" Template="{StaticResource KvietaAppIconTemplate}" />
                <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Kvieta" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource BackgroundActive}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10.5" Margin="0,2,0,0" />
                </StackPanel>
                <Ellipse Grid.Column="2" Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
            </Grid>
            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="2,0,2,4" />
            <Button Style="{StaticResource TrayActionStyle}" Click="OpenControlCenter_Click">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="25" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Path Data="{StaticResource TrayHomeIconGeometry}" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{DynamicResource ControlCenter}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0" />
                    <Path Grid.Column="2" Data="{StaticResource TrayChevronIconGeometry}" Stroke="{DynamicResource FaintTextBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="8" Height="12" Stretch="Uniform" VerticalAlignment="Center" />
                </Grid>
            </Button>
            <Button x:Name="SessionScreenButton" Style="{StaticResource TrayActionStyle}" Click="OpenSessionScreen_Click">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="25" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Path Data="{StaticResource TrayClockIconGeometry}" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{DynamicResource SessionScreen}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0" />
                    <Path Grid.Column="2" Data="{StaticResource TrayChevronIconGeometry}" Stroke="{DynamicResource FaintTextBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="8" Height="12" Stretch="Uniform" VerticalAlignment="Center" />
                </Grid>
            </Button>
            <Border x:Name="QuickFocusPanel" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="2,4,2,0" Padding="3,8,3,1">
                <StackPanel><TextBlock Text="{DynamicResource QuickFocus}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10.5" FontWeight="SemiBold" Margin="3,0,0,6"/><UniformGrid Columns="3"><Button Tag="25" Click="QuickFocus_Click" Style="{StaticResource TrayActionStyle}" Height="34" HorizontalContentAlignment="Center"><TextBlock><Run Text="25 "/><Run Text="{DynamicResource MinuteShort}"/></TextBlock></Button><Button Tag="50" Click="QuickFocus_Click" Style="{StaticResource TrayActionStyle}" Height="34" HorizontalContentAlignment="Center"><TextBlock><Run Text="50 "/><Run Text="{DynamicResource MinuteShort}"/></TextBlock></Button><Button Tag="90" Click="QuickFocus_Click" Style="{StaticResource TrayActionStyle}" Height="34" HorizontalContentAlignment="Center"><TextBlock><Run Text="90 "/><Run Text="{DynamicResource MinuteShort}"/></TextBlock></Button></UniformGrid></StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
