<Window x:Class="Kvieta.App.ManagerDeviceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kvieta" Width="520" Height="390" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="Transparent" AllowsTransparency="True" ShowInTaskbar="False">
    <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="26,22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="TitleText" FontSize="21" FontWeight="SemiBold"/>
            <TextBlock x:Name="DescriptionText" Grid.Row="1" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,16"/>
            <Border x:Name="CurrentDevicePanel" Grid.Row="2" Style="{StaticResource PanelStyle}" Padding="14" Margin="0,0,0,12" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="CurrentDeviceLabel" Foreground="{DynamicResource MutedTextBrush}" FontSize="10"/>
                    <TextBlock x:Name="CurrentDeviceName" FontSize="14" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    <TextBlock x:Name="CurrentDeviceId" Foreground="{DynamicResource FaintTextBrush}" FontSize="10" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
            <Border x:Name="EnrollmentPanel" Grid.Row="3" Style="{StaticResource PanelStyle}" Padding="16">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="NoDeviceTitle" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="NoDeviceDescription" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" LineHeight="17" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <TextBlock x:Name="ErrorText" Grid.Row="4" Foreground="{DynamicResource DangerBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>
            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button x:Name="CloseButton" Style="{StaticResource SecondaryButtonStyle}" Click="Close_Click" Margin="0,0,8,0"/>
                <Button x:Name="RevokeButton" Style="{StaticResource SecondaryButtonStyle}" Foreground="{DynamicResource WarningBrush}" Click="Revoke_Click" Visibility="Collapsed" Margin="0,0,8,0"/>
                <Button x:Name="TransferButton" Style="{StaticResource PrimaryButtonStyle}" Click="Transfer_Click" Visibility="Collapsed"/>
                <Button x:Name="PairButton" Style="{StaticResource PrimaryButtonStyle}" Click="Pair_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
