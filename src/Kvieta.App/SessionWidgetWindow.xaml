<Window x:Class="Kvieta.App.SessionWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:Kvieta.App.Services"
        Title="Kvieta" Width="270" Height="92" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" Background="Transparent" AllowsTransparency="True"
        Closing="Window_Closing" MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border x:Name="WidgetSurface" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="12" Padding="13,11">
        <Grid><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="11" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding TimeMetricLabelShort}" Foreground="{DynamicResource FaintTextBrush}" FontSize="10.5" FontWeight="SemiBold" /><TextBlock Text="{Binding RemainingText}" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="23" FontWeight="SemiBold" Margin="0,2,0,0" /><TextBlock Text="{DynamicResource TimeRunning}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,1,0,0" /></StackPanel>
            <Button Grid.Column="1" Content="{DynamicResource Break}" Style="{StaticResource SecondaryButtonStyle}" Background="{DynamicResource PrimarySoftBrush}" Foreground="{DynamicResource PrimaryBrush}" BorderThickness="0" Padding="12,7" VerticalAlignment="Center" Click="Pause_Click" />
            <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" services:MotionAssist.AnimatedValue="{Binding UsagePercent}" Maximum="100" Height="3" Margin="0,8,0,0" />
        </Grid>
    </Border>
</Window>
