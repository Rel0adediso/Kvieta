<Window x:Class="Kvieta.App.ManagerDeviceApprovalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kvieta" Width="500" Height="570" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="Transparent" AllowsTransparency="True" ShowInTaskbar="False">
    <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="26,22">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock x:Name="TitleText" FontSize="21" FontWeight="SemiBold"/>
            <TextBlock x:Name="DescriptionText" Grid.Row="1" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,16"/>
            <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="10" HorizontalAlignment="Center"><Image x:Name="QrImage" Width="250" Height="250" Stretch="Uniform"/></Border>
            <TextBlock x:Name="VerificationCodeText" Grid.Row="3" HorizontalAlignment="Center" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,10,0,0"/>
            <TextBox x:Name="UriBox" Grid.Row="4" IsReadOnly="True" Padding="9,6" FontFamily="Consolas" FontSize="10" Margin="0,10,0,0"/>
            <TextBlock x:Name="StatusText" Grid.Row="5" Foreground="{DynamicResource WarningBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CopyButton" Style="{StaticResource SecondaryButtonStyle}" Click="Copy_Click" Margin="0,0,8,0"/>
                <Button x:Name="CancelButton" Style="{StaticResource SecondaryButtonStyle}" Click="Cancel_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
