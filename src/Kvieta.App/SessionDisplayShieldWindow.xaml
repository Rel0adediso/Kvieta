<Window x:Class="Kvieta.App.SessionDisplayShieldWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kvieta · Oturum koruması"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        ShowActivated="False" Focusable="False" Closing="Window_Closing">
    <Grid Background="{DynamicResource BackgroundBrush}">
        <Border Width="360" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderStrongBrush}"
                BorderThickness="1" CornerRadius="16">
            <StackPanel>
                <TextBlock Text="KVIETA" Foreground="{DynamicResource PrimaryBrush}" FontSize="11"
                           FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="Oturum diğer ekranda yönetiliyor"
                           Foreground="{DynamicResource TextBrush}" FontSize="18" FontWeight="SemiBold"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0" />
                <TextBlock Text="Session controls are available on the primary display"
                           Foreground="{DynamicResource MutedTextBrush}" FontSize="11"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
