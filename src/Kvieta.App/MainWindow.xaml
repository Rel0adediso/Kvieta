                                        <Grid Grid.Row="2" Height="64" Margin="20,0"><Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="{DynamicResource Language}" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource LanguageDescription}" Style="{StaticResource CaptionStyle}" Margin="0,3,0,0" /></StackPanel><controls:SlidingSegmentedControl Grid.Column="1" Style="{StaticResource SegmentListStyle}" ItemContainerStyle="{StaticResource SegmentItemStyle}" ItemsSource="{Binding LanguageModes}" SelectedItem="{Binding LanguageMode}" SelectionChanged="Language_SelectionChanged" HorizontalAlignment="Left" VerticalAlignment="Center" /></Grid>
                                        <Border Grid.Row="3" Height="1" Background="{DynamicResource BorderBrush}" />
                                        <Grid Grid.Row="4" Height="64" Margin="20,0"><Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="{DynamicResource Appearance}" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource AppearanceDescription}" Style="{StaticResource CaptionStyle}" Margin="0,3,0,0" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><controls:SlidingSegmentedControl Style="{StaticResource SegmentListStyle}" ItemContainerStyle="{StaticResource SegmentItemStyle}" ItemsSource="{Binding ThemeModes}" SelectedItem="{Binding ThemeMode}" SelectionChanged="Theme_SelectionChanged" HorizontalAlignment="Left" VerticalAlignment="Center" /><CheckBox IsChecked="{Binding AnimationsEnabled}" Checked="Animations_Changed" Unchecked="Animations_Changed" Content="{DynamicResource AnimationsEnabled}" ToolTip="{DynamicResource AnimationsDescription}" Margin="18,0,0,0" VerticalAlignment="Center" /></StackPanel></Grid>
                                        <Border Grid.Row="5" Height="1" Background="{DynamicResource BorderBrush}" />
                                        <Grid Grid.Row="6" Height="64" Margin="20,0"><Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="{DynamicResource DeviceName}" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource DeviceNameDescription}" Style="{StaticResource CaptionStyle}" Margin="0,3,0,0" /></StackPanel><TextBox Grid.Column="1" Style="{StaticResource PlanInputStyle}" Text="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}" MaxLength="32" Width="300" Height="38" MinHeight="38" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="12,3" TextAlignment="Left" /></Grid>
                                        <Border Grid.Row="7" Height="1" Background="{DynamicResource BorderBrush}" Visibility="{Binding HasRestrictions, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <Grid Grid.Row="8" Height="64" Margin="20,0" Visibility="{Binding HasRestrictions, Converter={StaticResource BooleanToVisibilityConverter}}"><Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="{DynamicResource WhenTimeEnds}" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource WhenTimeEndsDescription}" Style="{StaticResource CaptionStyle}" Margin="0,3,14,0" TextWrapping="Wrap" /></StackPanel><controls:SlidingSegmentedControl Grid.Column="1" Style="{StaticResource SegmentListStyle}" ItemContainerStyle="{StaticResource SegmentItemStyle}" ItemsSource="{Binding LimitActions}" SelectedItem="{Binding LimitAction}" HorizontalAlignment="Left" VerticalAlignment="Center" /></Grid>
                                        <Border Grid.Row="9" Height="1" Background="{DynamicResource BorderBrush}" />
                                        <Grid Grid.Row="10" Height="64" Margin="20,0"><Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="{DynamicResource StartWithWindows}" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource StartWithWindowsDescription}" Style="{StaticResource CaptionStyle}" Margin="0,3,14,0" TextWrapping="Wrap" /></StackPanel><CheckBox Grid.Column="1" IsChecked="{Binding StartWithWindows}" VerticalAlignment="Center" Content="{DynamicResource Enabled}" /></Grid>
                                        <Border Grid.Row="11" Height="1" Background="{DynamicResource BorderBrush}" Visibility="{Binding HasRestrictions, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <Grid Grid.Row="12" Height="72" Margin="20,0" Visibility="{Binding HasRestrictions, Converter={StaticResource BooleanToVisibilityConverter}}"><Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="{DynamicResource AwarenessTracking}" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource AwarenessTrackingDescription}" Style="{StaticResource CaptionStyle}" Margin="0,3,14,0" TextWrapping="Wrap" /></StackPanel><CheckBox Grid.Column="1" IsChecked="{Binding AwarenessTrackingEnabled}" IsEnabled="{Binding HasRestrictions}" VerticalAlignment="Center" Content="{DynamicResource AwarenessTrackingConsent}" Checked="AwarenessTracking_Changed" Unchecked="AwarenessTracking_Changed" /></Grid>
                                    <Border Grid.Row="13" Height="1" Background="{DynamicResource BorderBrush}" Visibility="{Binding IsProtectedMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <Grid Grid.Row="14" Height="64" Margin="20,0" Visibility="{Binding IsProtectedMode, Converter={StaticResource BooleanToVisibilityConverter}}"><Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="{DynamicResource AdminPin}" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource AdminPinDescription}" Style="{StaticResource CaptionStyle}" Margin="0,3,14,0" TextWrapping="Wrap" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="{Binding AdminPinActionText}" Style="{StaticResource SecondaryButtonStyle}" Click="AdminPin_Click" /><TextBlock Text="{DynamicResource AdminPinActive}" Foreground="{DynamicResource SuccessBrush}" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0" Visibility="{Binding HasAdminPin, Converter={StaticResource BooleanToVisibilityConverter}}" /><Button Content="{DynamicResource RecoveryCodes}" Style="{StaticResource SecondaryButtonStyle}" Click="RecoveryCodes_Click" Margin="14,0,0,0" /><Button Content="{DynamicResource ManagerDevice}" Style="{StaticResource SecondaryButtonStyle}" Click="ManagerDevice_Click" Margin="8,0,0,0" /></StackPanel></Grid>
                                    </Grid></Border>
                                    <Border Grid.Row="2" Style="{StaticResource PanelStyle}" Margin="0,11,0,0" Padding="20,13" Visibility="{Binding IsPersonalMode, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="{DynamicResource PersonalStrictness}" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource PersonalStrictnessDescription}" Style="{StaticResource CaptionStyle}" Margin="0,3,12,0" TextWrapping="Wrap" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding ControlModeText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" /></Grid><Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,12" /><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="{DynamicResource RelaxationDelay}" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource RelaxationDelayDescription}" Style="{StaticResource CaptionStyle}" Margin="0,3,12,0" TextWrapping="Wrap" /></StackPanel><ComboBox Grid.Column="1" ItemsSource="{Binding ChangeDelayOptions}" SelectedItem="{Binding ChangeDelay}" Height="32" VerticalAlignment="Center" /><StackPanel Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center" Visibility="{Binding HasPendingChange, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="{Binding PendingChangeText}" Foreground="{DynamicResource WarningBrush}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding PendingChangeDetails}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0" LineHeight="16" /><Button Content="{DynamicResource CancelPending}" Style="{StaticResource SecondaryButtonStyle}" Click="CancelPending_Click" HorizontalAlignment="Left" Padding="10,4" Margin="0,7,0,0" /></StackPanel></Grid></StackPanel></Border>
                                    <Border Grid.Row="3" Style="{StaticResource PanelStyle}" Margin="0,11,0,0" Padding="20,14" Visibility="{Binding IsGuardianRequired, Converter={StaticResource BooleanToVisibilityConverter}}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="{DynamicResource DeviceProtection}" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource DeviceProtectionDescription}" Style="{StaticResource CaptionStyle}" Margin="0,4,18,0" TextWrapping="Wrap" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Border Width="7" Height="7" CornerRadius="4" Background="{DynamicResource FaintTextBrush}" Margin="0,0,7,0" x:Name="ProtectionStatusDot" /><TextBlock x:Name="ProtectionStatusText" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0" /><Button x:Name="ProtectionActionButton" Style="{StaticResource SecondaryButtonStyle}" Click="ProtectionAction_Click" Padding="13,6" /></StackPanel></Grid></Border>
                                    <Border Grid.Row="4" Style="{StaticResource PanelStyle}" Margin="0,11,0,0" Padding="20,15"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="{DynamicResource PrivacyCenter}" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource PrivacyCenterDescription}" Style="{StaticResource CaptionStyle}" Margin="0,4,18,0" TextWrapping="Wrap" /></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{DynamicResource RetentionPeriod}" Style="{StaticResource CaptionStyle}" FontSize="9" Margin="0,0,0,5" /><ComboBox ItemsSource="{Binding RetentionOptions}" SelectedItem="{Binding RetentionPeriod}" Width="145" Height="32" HorizontalAlignment="Left" /></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="JSON" Tag="json" Style="{StaticResource SecondaryButtonStyle}" Click="ExportUsage_Click" Padding="12,6" Margin="0,0,6,0" /><Button Content="CSV" Tag="csv" Style="{StaticResource SecondaryButtonStyle}" Click="ExportUsage_Click" Padding="12,6" Margin="0,0,6,0" /><Button Content="{DynamicResource ClearHistory}" Style="{StaticResource SecondaryButtonStyle}" Click="ClearUsageHistory_Click" Padding="12,6" Foreground="{DynamicResource WarningBrush}" /></StackPanel></Grid></Border>
                                    <Border Grid.Row="5" Style="{StaticResource PanelStyle}" Margin="0,11,0,0" Padding="20,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource RecoveryAndRepair}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource RecoveryAndRepairDescription}" Style="{StaticResource CaptionStyle}" Margin="0,4,18,0" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="{DynamicResource ExportDiagnostics}" Style="{StaticResource SecondaryButtonStyle}" Click="ExportDiagnostics_Click" Padding="12,6" Margin="0,0,8,0"/><Button Content="{DynamicResource OpenRecoveryCenter}" Style="{StaticResource ModeSelectorButtonStyle}" Click="RecoveryCenter_Click"/></StackPanel></Grid></Border>
                                    <Border Grid.Row="6" Style="{StaticResource PanelStyle}" Margin="0,11,0,0" Padding="20,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource UninstallTitle}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource UninstallSettingsDescription}" Style="{StaticResource CaptionStyle}" Margin="0,4,18,0" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" Content="{DynamicResource UninstallAction}" Style="{StaticResource SecondaryButtonStyle}" Foreground="{DynamicResource WarningBrush}" Click="UninstallKvieta_Click" Padding="13,7" VerticalAlignment="Center"/></Grid></Border>
                                    <Grid Grid.Row="7" Margin="2,13,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding SettingsPath}" Foreground="{DynamicResource FaintTextBrush}" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom" /><StackPanel Grid.Column="1" Margin="18,0,0,0"><TextBlock Text="{Binding BuildInformationText}" Foreground="{DynamicResource FaintTextBrush}" FontSize="10" TextAlignment="Right" /><TextBlock Text="{Binding InstallationInformationText}" Foreground="{DynamicResource FaintTextBrush}" FontSize="10" TextAlignment="Right" Margin="0,3,0,0" /></StackPanel></Grid>
                                </Grid>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Grid>

            <Grid x:Name="ApplicationDetailsOverlay" Grid.RowSpan="2" Panel.ZIndex="100" Visibility="Collapsed" Opacity="0" KeyboardNavigation.TabNavigation="Cycle">
                <Border Background="#76000000" MouseLeftButtonUp="ApplicationDetailsScrim_Click" />
                <Border x:Name="ApplicationDetailsPanel" Width="480" HorizontalAlignment="Right" Margin="0,12,12,12" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="0">
                    <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.32" Color="#000000" /></Border.Effect>
                    <Border.RenderTransform><TranslateTransform x:Name="ApplicationDetailsTranslate" X="520" /></Border.RenderTransform>
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="1" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid Margin="24,22,20,18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel><StackPanel Orientation="Horizontal"><Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource PrimarySoftBrush}"><Path Data="{StaticResource AppsIconGeometry}" Width="15" Height="15" Stretch="Uniform" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="{DynamicResource HistoryApplicationDetails}" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="18" FontWeight="SemiBold" Margin="11,0,0,0" VerticalAlignment="Center" /></StackPanel><TextBlock Text="{DynamicResource HistoryApplicationDetailsDescription}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,9,24,0" TextWrapping="Wrap" LineHeight="17" /></StackPanel>
                            <Button x:Name="ApplicationDetailsCloseButton" Grid.Column="1" Content="×" AutomationProperties.Name="{DynamicResource Close}" Width="32" Height="32" Padding="0" Style="{StaticResource SecondaryButtonStyle}" Click="ApplicationDetailsClose_Click" VerticalAlignment="Top" />
                        </Grid>
                        <Border Grid.Row="1" Background="{DynamicResource BorderBrush}" Margin="24,0" />
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="16,10,10,6">
                            <ItemsControl ItemsSource="{Binding HistoryAllApplications}">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Border Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="8" Padding="10,6" Margin="0,0,6,4">
                                        <Grid Height="42"><Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /><ColumnDefinition Width="96" /><ColumnDefinition Width="64" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding RankText}" Foreground="{DynamicResource FaintTextBrush}" FontSize="8" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <Grid Grid.Column="1" Width="28" Height="28" HorizontalAlignment="Left" VerticalAlignment="Center"><Border Background="{Binding FallbackBrush}" CornerRadius="8"><TextBlock Text="{Binding Initials}" Foreground="White" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasFallbackIcon, Converter={StaticResource BooleanToVisibilityConverter}}" /></Border><Image Source="{Binding Icon}" Width="24" Height="24" Stretch="Uniform" Visibility="{Binding HasIcon, Converter={StaticResource BooleanToVisibilityConverter}}" /></Grid>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><ProgressBar services:MotionAssist.AnimatedValue="{Binding RelativePercent}" Maximum="100" Height="4" Margin="0,6,16,0" /></StackPanel>
                                            <controls:Sparkline Grid.Column="3" Values="{Binding TrendValues}" LineBrush="{DynamicResource PrimaryBrush}" Width="82" Height="24" Margin="6,0,8,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="{Binding UsedText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
