<Window x:Class="Kvieta.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:services="clr-namespace:Kvieta.App.Services"
        xmlns:controls="clr-namespace:Kvieta.App.Controls"
        Title="Kvieta · Kontrol Merkezi" Width="1160" Height="730" MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource BackgroundBrush}" Loaded="Window_Loaded" SizeChanged="Window_SizeChanged" Closing="Window_Closing" Closed="Window_Closed" PreviewKeyDown="Window_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6" CornerRadius="10" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Geometry x:Key="HomeIconGeometry">M3,11 L12,3 L21,11 M5.5,9.5 V20 H18.5 V9.5 M9.5,20 V14 H14.5 V20</Geometry>
        <Geometry x:Key="PlanIconGeometry">M12,3 A9,9 0 1 1 11.99,3 M12,7 V12 L15.5,14</Geometry>
        <Geometry x:Key="AppsIconGeometry">M4,4 H10 V10 H4 Z M14,4 H20 V10 H14 Z M4,14 H10 V20 H4 Z M14,14 H20 V20 H14 Z</Geometry>
        <Geometry x:Key="HistoryIconGeometry">M3,12 A9,9 0 1 0 12,3 C9.4,3 7,4 5.25,5.75 L3,8 M3,3 V8 H8 M12,7 V12 L16,14</Geometry>
        <Geometry x:Key="SettingsIconGeometry">M4,7 H9 M13,7 H20 M4,12 H14 M18,12 H20 M4,17 H7 M11,17 H20 M9,5 V9 M16,10 V14 M7,15 V19</Geometry>
        <Geometry x:Key="ClockIconGeometry">M12,3 A9,9 0 1 1 11.99,3 M12,7 V12 L16,12</Geometry>
        <Geometry x:Key="ChevronIconGeometry">M9,6 L15,12 L9,18</Geometry>
        <Style x:Key="NavIconStyle" TargetType="Path"><Setter Property="Width" Value="18" /><Setter Property="Height" Value="18" /><Setter Property="Stretch" Value="Uniform" /><Setter Property="StrokeThickness" Value="1.6" /><Setter Property="StrokeStartLineCap" Value="Round" /><Setter Property="StrokeEndLineCap" Value="Round" /><Setter Property="StrokeLineJoin" Value="Round" /><Setter Property="Fill" Value="Transparent" /><Setter Property="Margin" Value="3,0" /><Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" /></Style>
        <Style x:Key="HeroPanelStyle" TargetType="Border" BasedOn="{StaticResource PanelStyle}"><Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" /><Setter Property="CornerRadius" Value="12" /></Style>
        <Style x:Key="SubtlePanelStyle" TargetType="Border" BasedOn="{StaticResource PanelStyle}"><Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}" /></Style>
        <Style x:Key="MetricLabelStyle" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource FaintTextBrush}" /><Setter Property="FontSize" Value="9.5" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
        <Style x:Key="MetricValueStyle" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" /><Setter Property="FontSize" Value="17" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
        <Style x:Key="HistoryDayItemStyle" TargetType="Border"><Setter Property="Background" Value="Transparent" /><Setter Property="CornerRadius" Value="8" /><Setter Property="Padding" Value="8,0" /><Setter Property="Margin" Value="0,1" /><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" /></Trigger><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}" /></DataTrigger></Style.Triggers></Style>
        <Style x:Key="WindowDotStyle" TargetType="Button">
            <Setter Property="Width" Value="14" /><Setter Property="Height" Value="14" /><Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,7,0" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#2A2B24" /><Setter Property="FontSize" Value="10" /><Setter Property="FontWeight" Value="Bold" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Grid><Ellipse x:Name="Dot" Fill="{TemplateBinding Background}" /><TextBlock x:Name="Symbol" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" Margin="0,-1,0,0" /></Grid>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Symbol" Property="Opacity" Value="1" /></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" /><Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="6,2" /><Setter Property="Padding" Value="8,0" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="NavBorder" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" /></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource NavSelectedBrush}" /><Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                    <Setter Property="Width" Value="40" /><Setter Property="Height" Value="40" /><Setter Property="Margin" Value="0,2" /><Setter Property="Padding" Value="0" /><Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="HorizontalContentAlignment" Value="Center" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FlatListItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,1" /><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Row" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter /></Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" /></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="HeaderStatusButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Padding" Value="0,2,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="StatusBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="5" Height="5" Fill="{DynamicResource PrimaryBrush}" Margin="0,0,7,0" VerticalAlignment="Center" Visibility="Collapsed" />
                        <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" />
                    </StackPanel>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="StatusBorder" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasPendingChange}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                    <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Padding" Value="7,3" />
                    <Setter Property="Margin" Value="-7,0,0,0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PlanInputStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="CaretBrush" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource PrimarySoftBrush}" /><Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Height" Value="30" /><Setter Property="Padding" Value="6,3" /><Setter Property="TextAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
                <Border x:Name="InputBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                    <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="InputBorder" Property="Background" Value="{DynamicResource InputBrush}" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="InputBorder" Property="Background" Value="{DynamicResource PrimarySoftBrush}" /><Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SegmentItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" /><Setter Property="Padding" Value="10,0" /><Setter Property="Height" Value="26" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Segment" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True" /><Condition Property="IsSelected" Value="False" /></MultiTrigger.Conditions><Setter TargetName="Segment" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" /></MultiTrigger><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ModeSelectorButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="236" /><Setter Property="Height" Value="38" /><Setter Property="Padding" Value="12,0" />
            <Setter Property="HorizontalAlignment" Value="Left" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ModeSelectorSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ModeSelectorSurface" Property="Background" Value="{DynamicResource PrimarySoftBrush}" /><Setter TargetName="ModeSelectorSurface" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ModeSelectorSurface" Property="Opacity" Value="0.76" /></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ModeSelectorSurface" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SegmentListStyle" TargetType="{x:Type controls:SlidingSegmentedControl}">
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="0" /><Setter Property="Height" Value="28" /><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" /><Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" /></DataTemplate></Setter.Value></Setter>
            <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></Setter.Value></Setter>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type controls:SlidingSegmentedControl}"><Grid ClipToBounds="True"><Border x:Name="PART_Indicator" Height="26" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource PrimaryBrush}" CornerRadius="5" IsHitTestVisible="False"><Border.RenderTransform><TranslateTransform /></Border.RenderTransform></Border><ItemsPresenter /></Grid></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PageTitleStyle" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" /><Setter Property="FontSize" Value="23" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="TextOptions.TextFormattingMode" Value="Ideal" /></Style>
        <Style x:Key="PageDescriptionStyle" TargetType="TextBlock"><Setter Property="FontSize" Value="11.5" /><Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" /><Setter Property="Margin" Value="0,5,0,0" /><Setter Property="LineHeight" Value="18" /></Style>
        <Style x:Key="CaptionStyle" TargetType="TextBlock"><Setter Property="FontSize" Value="10.5" /><Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" /></Style>
    </Window.Resources>

    <Border x:Name="RootFrame" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition Height="*" /></Grid.RowDefinitions>

            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="14,0">
                    <TextBlock Text="{DynamicResource ControlCenter}" Foreground="{DynamicResource FaintTextBrush}" FontSize="10" HorizontalAlignment="Left" VerticalAlignment="Center" />
                    <TextBlock Text="Kvieta" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="−" Background="#D9AE50" Style="{StaticResource WindowDotStyle}" ToolTip="{DynamicResource Minimize}" Click="Minimize_Click" />
                        <Button Content="+" Background="#7E9A62" Style="{StaticResource WindowDotStyle}" ToolTip="{DynamicResource Maximize}" Click="Maximize_Click" />
                        <Button Content="×" Background="#E66A5F" Style="{StaticResource WindowDotStyle}" Margin="0" ToolTip="{DynamicResource Close}" Click="Close_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="184" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

                <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="58" /><RowDefinition Height="*" /><RowDefinition Height="44" /></Grid.RowDefinitions>
                        <Grid>
                            <StackPanel Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ContentControl Width="30" Height="30" Template="{StaticResource KvietaAppIconTemplate}" />
                                <TextBlock Text="Kvieta" FontSize="16" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button x:Name="SidebarToggle" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Width="30" Height="30" Padding="0" Click="ToggleSidebar_Click" ToolTip="Menüyü daralt">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                        <Setter Property="Content" Value="‹" /><Setter Property="FontSize" Value="18" />
                                        <Style.Triggers><DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False"><Setter Property="Content" Value="›" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <ListBox Grid.Row="1" SelectedIndex="{Binding SelectedPageIndex, Mode=TwoWay}" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavItemStyle}" Margin="0,8,0,0">
                            <ListBoxItem><StackPanel Orientation="Horizontal"><Path Data="{StaticResource HomeIconGeometry}" Style="{StaticResource NavIconStyle}" /><TextBlock Text="{DynamicResource Today}" Margin="8,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" /></StackPanel></ListBoxItem>
                            <ListBoxItem Visibility="{Binding HasScheduledPlan, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource PlanIconGeometry}" Style="{StaticResource NavIconStyle}" /><TextBlock Text="{DynamicResource Plan}" Margin="8,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" /></StackPanel></ListBoxItem>
                            <ListBoxItem Visibility="{Binding HasRestrictions, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource AppsIconGeometry}" Style="{StaticResource NavIconStyle}" /><TextBlock Text="{DynamicResource Applications}" Margin="8,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" /></StackPanel></ListBoxItem>
                            <ListBoxItem><StackPanel Orientation="Horizontal"><Path Data="{StaticResource HistoryIconGeometry}" Style="{StaticResource NavIconStyle}" /><TextBlock Text="{DynamicResource History}" Margin="8,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" /></StackPanel></ListBoxItem>
                            <ListBoxItem><StackPanel Orientation="Horizontal"><Path Data="{StaticResource SettingsIconGeometry}" Style="{StaticResource NavIconStyle}" /><TextBlock Text="{DynamicResource Settings}" Margin="8,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" /></StackPanel></ListBoxItem>
                        </ListBox>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="20,0" VerticalAlignment="Center"><Ellipse Fill="{DynamicResource SuccessBrush}" Width="6" Height="6" /><TextBlock Text="{DynamicResource OnlyThisDevice}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" /></StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions><RowDefinition Height="60" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                        <Grid Margin="24,0">
                            <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding DeviceName}" FontSize="15" FontWeight="SemiBold" /><Button Content="{Binding HeaderStatusText}" Style="{StaticResource HeaderStatusButtonStyle}" Click="PendingHeader_Click" /></StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button x:Name="SessionScreenButton" Content="{DynamicResource SessionScreen}" Style="{StaticResource SecondaryButtonStyle}" Click="OpenCafeMode_Click" Margin="0,0,7,0" Padding="14,7" Visibility="{Binding HasRestrictions, Converter={StaticResource BooleanToVisibilityConverter}}" /><Button x:Name="SaveButton" Style="{StaticResource PrimaryButtonStyle}" Click="Save_Click" MinWidth="78" Padding="14,7"><Grid><TextBlock x:Name="SaveLabel" Text="{DynamicResource Save}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Center" /><TextBlock x:Name="SaveDonePanel" Text="{DynamicResource SavedShort}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Center" Opacity="0" IsHitTestVisible="False" /></Grid></Button></StackPanel>
                        </Grid>
                    </Border>

                    <TabControl x:Name="MainTabs" Grid.Row="1" SelectedIndex="{Binding SelectedPageIndex, Mode=TwoWay}" Background="Transparent" BorderThickness="0" SelectionChanged="MainTabs_SelectionChanged">
                        <TabControl.Resources><Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed" /></Style></TabControl.Resources>

                        <TabItem>
                            <ScrollViewer services:MotionAssist.SmoothScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <Grid Margin="24,20" MaxWidth="980">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <StackPanel><TextBlock Text="{DynamicResource Today}" Style="{StaticResource PageTitleStyle}" /><TextBlock Text="{Binding TodayDescriptionText}" Style="{StaticResource PageDescriptionStyle}" /></StackPanel>
                                    <Border Grid.Row="1" Style="{StaticResource HeroPanelStyle}" Margin="0,18,0,0" Padding="22">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.6*" /><ColumnDefinition Width="55" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                                            <Grid><Grid Visibility="{Binding HasRestrictions, Converter={StaticResource BooleanToVisibilityConverter}}"><Grid.ColumnDefinitions><ColumnDefinition Width="122" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid Width="108" Height="108" HorizontalAlignment="Left"><controls:CircularProgress Value="{Binding UsagePercent}" Maximum="100" TrackBrush="{DynamicResource PrimarySoftBrush}" IndicatorBrush="{DynamicResource PrimaryBrush}" StrokeThickness="5" /><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="{DynamicResource RemainingTime}" Foreground="{DynamicResource FaintTextBrush}" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Center" /><Viewbox Width="86" Height="30" Stretch="Uniform" StretchDirection="DownOnly" Margin="0,3,0,0"><TextBlock Text="{Binding RemainingText}" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="24" FontWeight="Light" TextAlignment="Center" /></Viewbox></StackPanel></Grid><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0"><TextBlock Text="{Binding UsedTodayDisplayText}" Style="{StaticResource CaptionStyle}" /><TextBlock Text="{Binding TodayLimitDisplayText}" FontSize="14" FontWeight="SemiBold" Margin="0,5,0,0" /><TextBlock Text="{Binding UsagePercent, StringFormat={}{0:0}%}" Foreground="{DynamicResource PrimaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,12,0,0" /></StackPanel></Grid><StackPanel Visibility="{Binding IsAwarenessMode, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalAlignment="Center"><TextBlock Text="{DynamicResource TodayTracked}" Style="{StaticResource SectionLabelStyle}" /><TextBlock Text="{Binding UsedTodayText}" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="34" FontWeight="Light" Margin="0,7,0,8" /><TextBlock Text="{DynamicResource TodayTrackedDescription}" Style="{StaticResource CaptionStyle}" /></StackPanel></Grid>
                                            <Border Grid.Column="1" Width="1" Background="{DynamicResource BorderBrush}" HorizontalAlignment="Center" />
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{DynamicResource RightNow}" Style="{StaticResource SectionLabelStyle}" /><TextBlock Text="{Binding CurrentWindowStatus}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,7,0,0" /></StackPanel>
                                        </Grid>
                                    </Border>
                                    <Grid Grid.Row="2" Margin="0,12,0,0" Visibility="{Binding HasRestrictions, Converter={StaticResource BooleanToVisibilityConverter}}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource PanelStyle}" Padding="17,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource PrimarySoftBrush}" VerticalAlignment="Center"><Path Data="{StaticResource ClockIconGeometry}" Width="15" Height="15" Stretch="Uniform" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.6" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="{DynamicResource TodayLimit}" Style="{StaticResource MetricLabelStyle}"/><TextBlock Text="{Binding TodayLimitText}" Style="{StaticResource MetricValueStyle}" Margin="0,4,0,0"/></StackPanel></Grid></Border>
                                        <Border Grid.Column="2" Style="{StaticResource PanelStyle}" Padding="17,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource SurfaceHoverBrush}" VerticalAlignment="Center"><Path Data="{StaticResource AppsIconGeometry}" Width="15" Height="15" Stretch="Uniform" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="{DynamicResource AppRule}" Style="{StaticResource MetricLabelStyle}"/><TextBlock Text="{Binding RuleCount}" Style="{StaticResource MetricValueStyle}" Margin="0,4,0,0"/></StackPanel></Grid></Border>
