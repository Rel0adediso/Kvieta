<Window x:Class="Kvieta.App.RecoveryResetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kvieta" Width="500" Height="500" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="Transparent" AllowsTransparency="True" ShowInTaskbar="False">
    <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="26,22">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="{DynamicResource ResetAdminPin}" FontSize="21" FontWeight="SemiBold" />
            <TextBlock x:Name="DescriptionText" Grid.Row="1" Text="{DynamicResource RecoveryResetDescription}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,16" />
            <StackPanel Grid.Row="2"><TextBlock Text="{DynamicResource NewPin}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/><PasswordBox x:Name="PinBox" Height="36" MaxLength="8" Margin="0,5,0,0" Padding="9,6" /></StackPanel>
            <StackPanel Grid.Row="3" Margin="0,12,0,0"><TextBlock Text="{DynamicResource PinRepeat}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/><PasswordBox x:Name="ConfirmPinBox" Height="36" MaxLength="8" Margin="0,5,0,0" Padding="9,6" /></StackPanel>
            <StackPanel Grid.Row="4" Margin="0,16,0,0">
                <StackPanel x:Name="RecoveryCodePanel">
                    <TextBlock Text="{DynamicResource RecoveryCodeOptionTitle}" FontSize="12" FontWeight="SemiBold"/>
                    <TextBox x:Name="CodeBox" Height="36" MaxLength="32" Margin="0,7,0,0" Padding="9,6" />
                </StackPanel>
                <Border x:Name="ManagerDevicePanel" Visibility="Collapsed" Margin="0,12,0,0" Padding="12" CornerRadius="8" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="{DynamicResource TrustedDeviceRecoveryTitle}" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ManagerDeviceDescriptionText" Text="{DynamicResource TrustedDeviceRecoveryDescription}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10.5" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button x:Name="ManagerDeviceButton" Grid.Column="1" Content="{DynamicResource UseManagerDevice}" Style="{StaticResource SecondaryButtonStyle}" Click="ManagerDevice_Click" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </StackPanel>
            <TextBlock x:Name="ErrorText" Grid.Row="5" Foreground="{DynamicResource DangerBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" />
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CancelButton" Content="{DynamicResource Cancel}" Style="{StaticResource SecondaryButtonStyle}" Click="Cancel_Click" Margin="0,0,8,0"/><Button x:Name="ResetButton" Content="{DynamicResource ResetWithRecoveryCode}" Style="{StaticResource PrimaryButtonStyle}" Click="Reset_Click"/></StackPanel>
        </Grid>
    </Border>
</Window>
