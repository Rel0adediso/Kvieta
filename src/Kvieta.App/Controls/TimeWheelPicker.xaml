<UserControl x:Class="Kvieta.App.Controls.TimeWheelPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" Width="84" Height="30" Focusable="False">
    <Grid>
        <ToggleButton x:Name="DropDownButton" Width="84" Height="30" Padding="0"
                      Background="{DynamicResource SurfaceRaisedBrush}"
                      BorderBrush="{DynamicResource BorderStrongBrush}"
                      BorderThickness="1" Checked="DropDownButton_Checked">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Shell" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                        <Grid Margin="10,0,8,0">
                            <TextBlock Text="{Binding TimeText, ElementName=Root}" FontSize="12"
                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Path Data="M2,3 L6,7 L10,3" Stroke="{DynamicResource MutedTextBrush}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                            <Setter TargetName="Shell" Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>

        <Popup x:Name="PickerPopup"
               IsOpen="{Binding IsChecked, ElementName=DropDownButton, Mode=TwoWay}"
               PlacementTarget="{Binding ElementName=DropDownButton}"
               Placement="Bottom" VerticalOffset="5"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Width="158" Padding="8" CornerRadius="10"
                    Background="{DynamicResource SurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="28" /><RowDefinition Height="180" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

                    <TextBlock Text="{DynamicResource HourUpper}" Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{DynamicResource MinuteUpper}" Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Border Grid.RowSpan="2" Grid.Column="1" Background="{DynamicResource BorderBrush}" />

                    <ListBox x:Name="HourInput" Grid.Row="1" Margin="0,0,6,0"
                             ItemsSource="{Binding Hours, ElementName=Root}"
                             SelectionChanged="TimePart_SelectionChanged"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="Padding" Value="8,6" /></Style></ListBox.ItemContainerStyle>
                    </ListBox>
                    <ListBox x:Name="MinuteInput" Grid.Row="1" Grid.Column="2" Margin="6,0,0,0"
                             ItemsSource="{Binding Minutes, ElementName=Root}"
                             SelectionChanged="TimePart_SelectionChanged"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="Padding" Value="8,6" /></Style></ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
