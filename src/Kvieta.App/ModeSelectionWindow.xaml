<Window x:Class="Kvieta.App.ModeSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="920" Height="455" MinWidth="460" MinHeight="340" WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen" Background="Transparent" AllowsTransparency="True"
        ShowInTaskbar="True" Title="Kvieta" Loaded="Window_Loaded">
    <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14">
        <Border.Resources>
            <Style x:Key="ModeCardStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}"><Setter Property="Padding" Value="22" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Stretch" /></Style>
            <Style x:Key="SelectedModeCardStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}"><Setter Property="Padding" Value="22" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Stretch" /></Style>
        </Border.Resources>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"><Grid Margin="16,0"><TextBlock Text="Kvieta" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" /><Button Content="×" Width="27" Height="27" Padding="0" HorizontalAlignment="Right" Style="{StaticResource SecondaryButtonStyle}" Click="Cancel_Click" /></Grid></Border>
            <Grid x:Name="UsageStepPanel" Grid.Row="1" MinHeight="350" Margin="34,26,34,30">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="{DynamicResource ChooseModeTitle}" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Grid.Row="1" Text="{DynamicResource ChooseModeDescription}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,7,0,22" />
                <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Button x:Name="AwarenessButton" Style="{StaticResource ModeCardStyle}" Click="Awareness_Click"><StackPanel><TextBlock Text="{DynamicResource AwarenessMode}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource AwarenessModeDescription}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="19" Opacity="0.78" /><TextBlock Text="{DynamicResource AwarenessModeHint}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="11" Margin="0,18,0,0" TextWrapping="Wrap" Opacity="0.9" /></StackPanel></Button>
                    <Button x:Name="PersonalButton" Grid.Column="2" Style="{StaticResource ModeCardStyle}" Click="Personal_Click"><StackPanel><TextBlock Text="{DynamicResource PersonalMode}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource PersonalModeDescription}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="19" Opacity="0.78" /><TextBlock Text="{DynamicResource PersonalModeHint}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="11" Margin="0,18,0,0" TextWrapping="Wrap" Opacity="0.9" /></StackPanel></Button>
                    <Button x:Name="ProtectedButton" Grid.Column="4" Style="{StaticResource ModeCardStyle}" Click="Protected_Click"><StackPanel><TextBlock Text="{DynamicResource ProtectedMode}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource ProtectedModeDescription}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="19" Opacity="0.78" /><TextBlock Text="{DynamicResource ProtectedModeHint}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="11" Margin="0,18,0,0" TextWrapping="Wrap" Opacity="0.9" /></StackPanel></Button>
                </Grid>
                <Grid Grid.Row="3" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="128" /><ColumnDefinition Width="*" /><ColumnDefinition Width="128" /></Grid.ColumnDefinitions><TextBlock Grid.Column="1" Text="{DynamicResource ModeCanChangeLater}" Foreground="{DynamicResource FaintTextBrush}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /><Button x:Name="ConfirmModeButton" Grid.Column="2" Content="{DynamicResource ConfirmModeSelection}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" MinWidth="128" Padding="14,7" Click="Confirm_Click" /></Grid>
            </Grid>
            <Grid x:Name="PersonalStepPanel" Grid.Row="1" MinHeight="350" Margin="34,26,34,30" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="{DynamicResource ChoosePersonalLevelTitle}" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Grid.Row="1" Text="{DynamicResource ChoosePersonalLevelDescription}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,7,0,22" />
                <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Button x:Name="FlexibleButton" Style="{StaticResource ModeCardStyle}" Click="Flexible_Click"><StackPanel><TextBlock Text="{DynamicResource PersonalFlexible}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource PersonalFlexibleDescription}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="19" Opacity="0.78" /><TextBlock Text="{DynamicResource PersonalFlexibleHint}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="11" Margin="0,18,0,0" TextWrapping="Wrap" Opacity="0.9" /></StackPanel></Button>
                    <Button x:Name="BalancedButton" Grid.Column="2" Style="{StaticResource ModeCardStyle}" Click="Balanced_Click"><StackPanel><TextBlock Text="{DynamicResource PersonalBalanced}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource PersonalBalancedDescription}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="19" Opacity="0.78" /><TextBlock Text="{DynamicResource PersonalBalancedHint}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="11" Margin="0,18,0,0" TextWrapping="Wrap" Opacity="0.9" /></StackPanel></Button>
                    <Button x:Name="GuardedButton" Grid.Column="4" Style="{StaticResource ModeCardStyle}" Click="Guarded_Click"><StackPanel><TextBlock Text="{DynamicResource PersonalGuarded}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource PersonalGuardedDescription}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="19" Opacity="0.78" /><TextBlock Text="{DynamicResource PersonalGuardedHint}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="11" Margin="0,18,0,0" TextWrapping="Wrap" Opacity="0.9" /></StackPanel></Button>
                </Grid>
                <Grid Grid.Row="3" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="128" /><ColumnDefinition Width="*" /><ColumnDefinition Width="128" /></Grid.ColumnDefinitions><Button Content="{DynamicResource Back}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" MinWidth="108" Padding="14,7" Click="Back_Click" /><TextBlock Grid.Column="1" Text="{DynamicResource PersonalLevelCanChangeLater}" Foreground="{DynamicResource FaintTextBrush}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /><Button Grid.Column="2" Content="{DynamicResource ConfirmModeSelection}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" MinWidth="128" Padding="14,7" Click="ConfirmPersonal_Click" /></Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
