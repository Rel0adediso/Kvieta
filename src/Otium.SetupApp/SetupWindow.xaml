<Window x:Class="Otium.SetupApp.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="960" Height="600" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="Transparent" AllowsTransparency="True" Title="Otium Setup">
    <Border Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="18,0,10,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="24" Height="24" Background="{StaticResource PrimaryBrush}" CornerRadius="8"><TextBlock Text="O" Foreground="#171A12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="Otium" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" /></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="—" Width="36" Background="Transparent" Foreground="{StaticResource MutedTextBrush}" BorderThickness="0" Click="Minimize_Click" /><Button Content="×" Width="36" Background="Transparent" Foreground="{StaticResource MutedTextBrush}" BorderThickness="0" FontSize="18" Click="Close_Click" /></StackPanel></Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="310" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Background="#171A13" CornerRadius="0,0,0,15" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                    <Grid Margin="38"><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel VerticalAlignment="Center"><Border Width="62" Height="62" Background="{StaticResource PrimaryBrush}" CornerRadius="20" HorizontalAlignment="Left"><TextBlock Text="O" Foreground="#171A12" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="Otium" FontSize="31" FontWeight="SemiBold" Margin="0,22,0,0" /><TextBlock Text="Zamanın üzerinde yeniden söz sahibi ol." Foreground="{StaticResource MutedTextBrush}" FontSize="14" TextWrapping="Wrap" LineHeight="22" Margin="0,10,0,0" /><Border Background="{StaticResource PrimarySoftBrush}" CornerRadius="9" Padding="13,10" Margin="0,34,0,0"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{StaticResource PrimaryBrush}" Margin="0,0,9,0" /><TextBlock Text="Verilerin yalnızca bu cihazda" FontSize="11" Foreground="{StaticResource MutedTextBrush}" /></StackPanel></Border></StackPanel><TextBlock Grid.Row="1" Text="Otium · v1.0" Foreground="#747A69" FontSize="10" /></Grid>
                </Border>

                <Grid x:Name="LanguagePanel" Grid.Column="1" Margin="54,42,54,38">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Text="Dilini seç · Choose your language" FontSize="27" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Text="Kurulum ve ilk ayarlar seçtiğin dilde devam edecek." Foreground="{StaticResource MutedTextBrush}" FontSize="13" Margin="0,10,0,0" />
                    <StackPanel Grid.Row="2" VerticalAlignment="Center">
                        <Button x:Name="TurkishButton" Style="{StaticResource LanguageCard}" Click="Turkish_Click" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="28" /></Grid.ColumnDefinitions><Border Width="34" Height="34" Background="#8E332C" CornerRadius="17"><TextBlock Text="TR" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" Margin="14,0"><TextBlock Text="Türkçe" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="Kuruluma Türkçe devam et" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,4,0,0" /></StackPanel><TextBlock x:Name="TurkishCheck" Grid.Column="2" Text="✓" Foreground="{StaticResource PrimaryBrush}" FontSize="18" Visibility="Collapsed" VerticalAlignment="Center" /></Grid></Button>
                        <Button x:Name="EnglishButton" Style="{StaticResource LanguageCard}" Click="English_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="28" /></Grid.ColumnDefinitions><Border Width="34" Height="34" Background="#334966" CornerRadius="17"><TextBlock Text="EN" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" Margin="14,0"><TextBlock Text="English" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="Continue setup in English" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,4,0,0" /></StackPanel><TextBlock x:Name="EnglishCheck" Grid.Column="2" Text="✓" Foreground="{StaticResource PrimaryBrush}" FontSize="18" Visibility="Collapsed" VerticalAlignment="Center" /></Grid></Button>
                    </StackPanel>
                    <Grid Grid.Row="3"><TextBlock x:Name="PrivacyText" Text="Dil seçimini daha sonra Ayarlar'dan değiştirebilirsin." Foreground="{StaticResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center" /><Button x:Name="ContinueButton" Content="Devam et" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" IsEnabled="False" Click="Continue_Click" /></Grid>
                </Grid>

                <Grid x:Name="WelcomePanel" Grid.Column="1" Margin="54,42,54,38" Visibility="Collapsed"><StackPanel VerticalAlignment="Center"><TextBlock x:Name="WelcomeEyebrow" Text="KURULUMA HAZIR" Foreground="{StaticResource PrimaryBrush}" FontSize="11" FontWeight="SemiBold" /><TextBlock x:Name="WelcomeTitle" Text="Otium'a hoş geldin." FontSize="32" FontWeight="SemiBold" Margin="0,12,0,0" /><TextBlock x:Name="WelcomeDescription" Text="Sonraki ekranda kullanım biçimini ve başlangıç ayarlarını birlikte seçeceğiz." Foreground="{StaticResource MutedTextBrush}" FontSize="14" TextWrapping="Wrap" LineHeight="23" Margin="0,12,0,30" /><Button x:Name="BackButton" Content="Dili değiştir" Style="{StaticResource LanguageCard}" HorizontalAlignment="Left" Padding="18,10" Click="Back_Click" /></StackPanel></Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
