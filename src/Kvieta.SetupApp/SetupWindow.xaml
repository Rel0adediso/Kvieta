<Window x:Class="Kvieta.SetupApp.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1020" Height="660" MinWidth="880" MinHeight="570"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="Transparent" AllowsTransparency="True" Title="Kvieta Setup"
        Loaded="Window_Loaded" Closed="Window_Closed" Closing="Window_Closing">
    <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="18,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ContentControl Width="24" Height="24" Template="{StaticResource KvietaAppIconTemplate}" />
                        <TextBlock Text="Kvieta Setup" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="—" Width="36" Style="{StaticResource TitleBarButton}" Click="Minimize_Click" />
                        <Button x:Name="CloseButton" Content="×" Width="36" Style="{StaticResource TitleBarButton}" FontSize="18"
                                Click="Close_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Background="{DynamicResource SidebarBrush}" CornerRadius="0,0,0,15"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                    <Grid Margin="36">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <ContentControl Width="58" Height="58" Template="{StaticResource KvietaAppIconTemplate}"
                                            HorizontalAlignment="Left" />
                            <TextBlock Text="Kvieta" FontSize="30" FontWeight="SemiBold" Margin="0,20,0,0" />
                            <TextBlock x:Name="SidebarTagline" Text="Her şeyin bir zamanı var."
                                       Foreground="{DynamicResource MutedTextBrush}" FontSize="13"
                                       TextWrapping="Wrap" LineHeight="21" Margin="0,8,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" VerticalAlignment="Center">
                            <TextBlock x:Name="StepLabel" Text="ADIM 1 / 8" Foreground="{DynamicResource PrimaryBrush}"
                                       FontSize="10" FontWeight="SemiBold" />
                            <ProgressBar x:Name="StepProgress" Minimum="1" Maximum="9" Value="1" Height="4"
                                         Margin="0,10,0,18" Foreground="{DynamicResource PrimaryBrush}"
                                         Background="{DynamicResource PrimarySoftBrush}" />
                            <TextBlock x:Name="StepTitle" Text="Dil seçimi" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock x:Name="StepDescription" Text="Kurulum ve Kvieta aynı dilde devam eder."
                                       Foreground="{DynamicResource MutedTextBrush}" FontSize="11"
                                       TextWrapping="Wrap" LineHeight="18" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="2">
                            <Border Background="{DynamicResource PrimarySoftBrush}" CornerRadius="9" Padding="12,9">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource PrimaryBrush}" Margin="0,0,9,0" />
                                    <TextBlock x:Name="LocalDataText" Text="Veriler yalnızca bu cihazda"
                                               FontSize="10.5" Foreground="{DynamicResource MutedTextBrush}" />
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="VersionText" Text="Kvieta · 1.0.0-alpha" Foreground="{DynamicResource FaintTextBrush}"
                                       FontSize="10" Margin="0,14,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Margin="52,38,52,34">
                    <Grid x:Name="LanguagePanel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="*" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="LanguageTitle" Text="Dilini seç · Choose your language" FontSize="27" FontWeight="SemiBold" />
                        <TextBlock x:Name="LanguageDescription" Grid.Row="1" Text="Kurulum ve ilk ayarlar seçtiğin dilde devam edecek."
                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="13" Margin="0,9,0,0" />
                        <StackPanel Grid.Row="2" VerticalAlignment="Center">
                            <Button x:Name="TurkishButton" Style="{StaticResource LanguageCard}"
                                    Click="Turkish_Click" Margin="0,0,0,14">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46" /><ColumnDefinition Width="*" /><ColumnDefinition Width="28" /></Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" Background="#8E332C" CornerRadius="18"><TextBlock Text="TR" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                    <StackPanel Grid.Column="1" Margin="14,0"><TextBlock Text="Türkçe" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="Kuruluma Türkçe devam et" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,4,0,0" /></StackPanel>
                                    <Path x:Name="TurkishCheck" Grid.Column="2" Data="{StaticResource CheckIconGeometry}" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="14" Stretch="Uniform" Visibility="Collapsed" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button x:Name="EnglishButton" Style="{StaticResource LanguageCard}" Click="English_Click">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46" /><ColumnDefinition Width="*" /><ColumnDefinition Width="28" /></Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" Background="#334966" CornerRadius="18"><TextBlock Text="EN" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                    <StackPanel Grid.Column="1" Margin="14,0"><TextBlock Text="English" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="Continue setup in English" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,4,0,0" /></StackPanel>
                                    <Path x:Name="EnglishCheck" Grid.Column="2" Data="{StaticResource CheckIconGeometry}" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="14" Stretch="Uniform" Visibility="Collapsed" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </StackPanel>
                        <Button x:Name="LanguageNextButton" Grid.Row="3" Content="Devam et"
                                Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                                IsEnabled="False" Click="LanguageNext_Click" />
                    </Grid>

                    <Grid x:Name="WelcomePanel" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="WelcomeEyebrow" Text="SAKİN · YEREL · SENİN KONTROLÜNDE"
                                       Foreground="{DynamicResource PrimaryBrush}" FontSize="10.5" FontWeight="SemiBold" />
                            <TextBlock x:Name="WelcomeTitle" Text="Kvieta'ya hoş geldin." FontSize="32" FontWeight="SemiBold" Margin="0,12,0,0" />
                            <TextBlock x:Name="WelcomeDescription" Text="Kvieta ekran süreni cihazında ölçer; istersen yalnızca gösterir, istersen verdiğin kararlara sadık kalmana yardım eder."
                                       Foreground="{DynamicResource MutedTextBrush}" FontSize="14" TextWrapping="Wrap" LineHeight="23" Margin="0,12,0,24" />
                            <UniformGrid Columns="3">
                                <Border Style="{StaticResource FeatureBox}" Margin="0,0,8,0"><StackPanel><Path Data="{StaticResource ClockIconGeometry}" Width="21" Height="21" Stretch="Uniform" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Left"/><TextBlock x:Name="FeatureLocalTitle" Text="Yerel ölçüm" FontWeight="SemiBold" Margin="0,10,0,0" /><TextBlock x:Name="FeatureLocalText" Text="Uygulama adı ve kullanım süresi cihazında ölçülür. Hesap veya bulut gerekmez." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" FontSize="12" LineHeight="18" Margin="0,5,0,0" /></StackPanel></Border>
                                <Border Style="{StaticResource FeatureBox}" Margin="4,0"><StackPanel><Path Data="{StaticResource GridIconGeometry}" Width="21" Height="21" Stretch="Uniform" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.6" HorizontalAlignment="Left"/><TextBlock x:Name="FeatureChoiceTitle" Text="Üç kullanım biçimi" FontWeight="SemiBold" Margin="0,10,0,0" /><TextBlock x:Name="FeatureChoiceText" Text="Yalnız takip et, kendi planına destek al veya kuralları Guardian ile koru." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" FontSize="12" LineHeight="18" Margin="0,5,0,0" /></StackPanel></Border>
                                <Border Style="{StaticResource FeatureBox}" Margin="8,0,0,0"><StackPanel><Path Data="{StaticResource ShieldIconGeometry}" Width="21" Height="21" Stretch="Uniform" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.7" StrokeLineJoin="Round" HorizontalAlignment="Left"/><TextBlock x:Name="FeaturePrivateTitle" Text="İçerik kaydı yok" FontWeight="SemiBold" Margin="0,10,0,0" /><TextBlock x:Name="FeaturePrivateText" Text="Pencere başlıklarını, yazdıklarını veya ekran görüntülerini hiçbir zaman saklamaz." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" FontSize="12" LineHeight="18" Margin="0,5,0,0" /></StackPanel></Border>
                            </UniformGrid>
                        </StackPanel>
                        <Grid Grid.Row="1"><Button x:Name="WelcomeBackButton" Content="Geri" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="WelcomeBack_Click" /><Button x:Name="WelcomeNextButton" Content="Devam et" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Click="WelcomeNext_Click" /></Grid>
                    </Grid>

                    <Grid x:Name="ExistingPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock x:Name="ExistingTitle" Text="Bu cihazda Kvieta ayarları bulundu." FontSize="27" FontWeight="SemiBold" />
                        <TextBlock x:Name="ExistingDescription" Grid.Row="1" Text="Kullanım geçmişin silinmez. Mevcut ayarlarla devam edebilir veya ayarları baştan yapılandırabilirsin." Foreground="{DynamicResource MutedTextBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,9,0,0" />
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,12,0,12">
                          <StackPanel VerticalAlignment="Center">
                            <Border x:Name="ExistingVersionCard" Style="{StaticResource FeatureBox}" Margin="0,0,0,14">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock x:Name="InstalledVersionLabel" Text="KURULU" Foreground="{DynamicResource MutedTextBrush}" FontSize="9.5"/><TextBlock x:Name="InstalledVersionValue" Text="1.0.0" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                                    <TextBlock Grid.Column="1" Text="→" Foreground="{DynamicResource PrimaryBrush}" FontSize="20" VerticalAlignment="Center" Margin="28,0"/>
                                    <StackPanel Grid.Column="2"><TextBlock x:Name="PackageVersionLabel" Text="BU PAKET" Foreground="{DynamicResource MutedTextBrush}" FontSize="9.5"/><TextBlock x:Name="PackageVersionValue" Text="1.0.0-alpha" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                                </Grid>
                            </Border>
                            <Button x:Name="KeepExistingButton" Style="{StaticResource LanguageCard}" Click="KeepExisting_Click" Margin="0,0,0,14"><StackPanel><TextBlock x:Name="KeepExistingTitle" Text="Mevcut ayarlarla devam et" FontSize="16" FontWeight="SemiBold" /><TextBlock x:Name="KeepExistingText" Text="Kurulumu yenile; modunu, kurallarını ve geçmişini koru." Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,5,0,0" /></StackPanel></Button>
                            <Button x:Name="ConfigureNewButton" Style="{StaticResource LanguageCard}" Click="ConfigureNew_Click"><StackPanel><TextBlock x:Name="ConfigureNewTitle" Text="Ayarları baştan yapılandır" FontSize="16" FontWeight="SemiBold" /><TextBlock x:Name="ConfigureNewText" Text="Mod ve başlangıç ayarlarını yeniden seç; geçmiş verilerine dokunma." Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,5,0,0" /></StackPanel></Button>
                            <Button x:Name="ResetBrokenProtectionButton" Style="{StaticResource LanguageCard}" Click="ResetBrokenProtection_Click" Margin="0,14,0,0" Visibility="Collapsed"><StackPanel><TextBlock x:Name="ResetBrokenProtectionTitle" Text="Bozuk korumayı sıfırla" FontSize="16" FontWeight="SemiBold" /><TextBlock x:Name="ResetBrokenProtectionText" Text="Kurtarılamayan eski PIN ve Guardian kaydını temizleyip kurulumu yeniden yap." Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,5,0,0" /></StackPanel></Button>
                            <TextBlock x:Name="ExistingSecurityNotice" Foreground="#D89A64" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0" />
                          </StackPanel>
                        </ScrollViewer>
                        <Button x:Name="ExistingBackButton" Grid.Row="3" Content="Geri" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="ExistingBack_Click" />
                    </Grid>

                    <Grid x:Name="ModePanel" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock x:Name="ModeTitle" Text="Kvieta'yı nasıl kullanacaksın?" FontSize="27" FontWeight="SemiBold" />
                        <TextBlock x:Name="ModeDescription" Grid.Row="1" Text="İhtiyacına en yakın biçimi seç; ayrıntıları daha sonra değiştirebilirsin." Foreground="{DynamicResource MutedTextBrush}" FontSize="13" Margin="0,9,0,0" />
                        <UniformGrid Grid.Row="2" Columns="3" Margin="0,26,0,20">
                            <Button x:Name="AwarenessButton" Style="{StaticResource ModeCard}" Margin="0,0,8,0" Click="Awareness_Click"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Path Data="{StaticResource AwarenessIconGeometry}" Width="23" Height="23" Stretch="Uniform" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.7" StrokeLineJoin="Round" HorizontalAlignment="Left"/><TextBlock x:Name="AwarenessTitle" Grid.Row="1" Text="Sadece takip" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,0" /><TextBlock x:Name="AwarenessText" Grid.Row="2" Text="Kısıtlama olmadan hangi uygulamayı ne kadar kullandığını gör." Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="19" Margin="0,8,0,0" /><TextBlock x:Name="AwarenessDetails" Grid.Row="3" Text="• Engel veya zorunlu mola yok&#10;• Başlangıç ritmi ve haftalık eğilim&#10;• Tüm veriler yalnız bu cihazda" Foreground="{DynamicResource MutedTextBrush}" FontSize="11.5" TextWrapping="Wrap" LineHeight="20" Margin="0,18,0,0"/><TextBlock x:Name="AwarenessBestFor" Grid.Row="4" Text="En hafif başlangıç" Foreground="{DynamicResource PrimaryBrush}" FontSize="11.5" FontWeight="SemiBold" Margin="0,14,0,0"/></Grid></Button>
                            <Button x:Name="PersonalButton" Style="{StaticResource ModeCard}" Margin="4,0" Click="Personal_Click"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Path Data="{StaticResource CompassIconGeometry}" Width="23" Height="23" Stretch="Uniform" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.7" StrokeLineJoin="Round" HorizontalAlignment="Left"/><TextBlock x:Name="PersonalTitle" Grid.Row="1" Text="Kendim için" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,0" /><TextBlock x:Name="PersonalText" Grid.Row="2" Text="Odaklan ve kendi koyduğun sınırlara seçtiğin güçte bağlı kal." Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="19" Margin="0,8,0,0" /><TextBlock x:Name="PersonalDetails" Grid.Row="3" Text="• Günlük plan, limit ve uygulama kuralları&#10;• Esnek, Dengeli veya Gözetimli düzey&#10;• Gevşetmeler seçtiğin süre kadar bekler" Foreground="{DynamicResource MutedTextBrush}" FontSize="11.5" TextWrapping="Wrap" LineHeight="20" Margin="0,18,0,0"/><TextBlock x:Name="PersonalBestFor" Grid.Row="4" Text="Kendi kararlarına destek" Foreground="{DynamicResource PrimaryBrush}" FontSize="11.5" FontWeight="SemiBold" Margin="0,14,0,0"/></Grid></Button>
                            <Button x:Name="ProtectedButton" Style="{StaticResource ModeCard}" Margin="8,0,0,0" Click="Protected_Click"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Path Data="{StaticResource ShieldIconGeometry}" Width="23" Height="23" Stretch="Uniform" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.7" StrokeLineJoin="Round" HorizontalAlignment="Left"/><TextBlock x:Name="ProtectedTitle" Grid.Row="1" Text="Yönettiğim biri için" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,0" /><TextBlock x:Name="ProtectedText" Grid.Row="2" Text="Kuralları yönetici PIN'i ve Guardian ile koru." Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="19" Margin="0,8,0,0" /><TextBlock x:Name="ProtectedDetails" Grid.Row="3" Text="• Ayarlar ve çıkış yönetici PIN'iyle korunur&#10;• Guardian kapatılan oturumu yeniden açar&#10;• Yönetici onayı olmadan gevşetilemez" Foreground="{DynamicResource MutedTextBrush}" FontSize="11.5" TextWrapping="Wrap" LineHeight="20" Margin="0,18,0,0"/><TextBlock x:Name="ProtectedBestFor" Grid.Row="4" Text="Yönetilen Windows hesabı" Foreground="{DynamicResource PrimaryBrush}" FontSize="11.5" FontWeight="SemiBold" Margin="0,14,0,0"/></Grid></Button>
                        </UniformGrid>
                        <Grid Grid.Row="3"><Button x:Name="ModeBackButton" Content="Geri" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="ModeBack_Click" /><Button x:Name="ModeNextButton" Content="Devam et" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" IsEnabled="False" Click="ModeNext_Click" /></Grid>
                    </Grid>

                    <Grid x:Name="PersonalPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock x:Name="PersonalLevelTitle" Text="Ne kadar destek istersin?" FontSize="27" FontWeight="SemiBold" />
                        <TextBlock x:Name="PersonalLevelDescription" Grid.Row="1" Text="Kendim için modunun davranışını seç." Foreground="{DynamicResource MutedTextBrush}" FontSize="13" Margin="0,9,0,0" />
                        <StackPanel Grid.Row="2" VerticalAlignment="Center">
                            <Button x:Name="FlexibleButton" Style="{StaticResource LanguageCard}" Click="Flexible_Click" Margin="0,0,0,10"><StackPanel><TextBlock x:Name="FlexibleTitle" Text="Esnek" FontSize="15" FontWeight="SemiBold" /><TextBlock x:Name="FlexibleText" Text="Manuel odak oturumlarını istediğin zaman başlat, duraklat ve bitir." Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,5,0,0" /></StackPanel></Button>
                            <Button x:Name="BalancedButton" Style="{StaticResource LanguageCard}" Click="Balanced_Click" Margin="0,0,0,10"><StackPanel><TextBlock x:Name="BalancedTitle" Text="Dengeli · Önerilen" FontSize="15" FontWeight="SemiBold" /><TextBlock x:Name="BalancedText" Text="Planını uygular; kural gevşetmelerinde bekleme süresi kullanır." Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,5,0,0" /></StackPanel></Button>
                            <Button x:Name="GuardedButton" Style="{StaticResource LanguageCard}" Click="Guarded_Click"><StackPanel><TextBlock x:Name="GuardedTitle" Text="Gözetimli" FontSize="15" FontWeight="SemiBold" /><TextBlock x:Name="GuardedText" Text="Dengeli davranışa Windows Guardian süreç korumasını ekler." Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,5,0,0" /></StackPanel></Button>
                        </StackPanel>
                        <Grid Grid.Row="3"><Button x:Name="PersonalBackButton" Content="Geri" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="PersonalBack_Click" /><Button x:Name="PersonalNextButton" Content="Devam et" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Click="PersonalNext_Click" /></Grid>
                    </Grid>

                    <Grid x:Name="SchedulePanel" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock x:Name="ScheduleTitle" Text="Haftalık planını oluştur" FontSize="27" FontWeight="SemiBold" />
                        <TextBlock x:Name="ScheduleDescription" Grid.Row="1" Text="Her gün için kullanılabilecek saat aralığını ve toplam süreyi belirle." Foreground="{DynamicResource MutedTextBrush}" FontSize="13" Margin="0,9,0,0" />
                        <Border Grid.Row="2" Style="{StaticResource FeatureBox}" Padding="0" Margin="0,20,0,12" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Grid Margin="16,0"><Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="104" /><ColumnDefinition Width="104" /><ColumnDefinition Width="116" /></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ScheduleEnabledHeader" Text="AÇIK" Foreground="{DynamicResource FaintTextBrush}" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock x:Name="ScheduleDayHeader" Grid.Column="1" Text="GÜN" Foreground="{DynamicResource FaintTextBrush}" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock x:Name="ScheduleStartHeader" Grid.Column="2" Text="BAŞLANGIÇ" Foreground="{DynamicResource FaintTextBrush}" FontSize="10.5" FontWeight="SemiBold" TextAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock x:Name="ScheduleEndHeader" Grid.Column="3" Text="BİTİŞ" Foreground="{DynamicResource FaintTextBrush}" FontSize="10.5" FontWeight="SemiBold" TextAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock x:Name="ScheduleLimitHeader" Grid.Column="4" Text="LİMİT (DK)" Foreground="{DynamicResource FaintTextBrush}" FontSize="10.5" FontWeight="SemiBold" TextAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <ItemsControl x:Name="ScheduleDaysControl" Grid.Row="1">
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <Border Height="48" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,0">
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="104" /><ColumnDefinition Width="104" /><ColumnDefinition Width="116" /></Grid.ColumnDefinitions>
                                                <CheckBox x:Name="ScheduleEnabledBox" IsChecked="{Binding IsEnabled}" AutomationProperties.Name="{Binding EnabledAutomationName}" Width="28" Height="28" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding DayName}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <TextBox Grid.Column="2" Style="{StaticResource ScheduleInput}" Text="{Binding AllowedFromText, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="{Binding StartAutomationName}" IsEnabled="{Binding IsChecked, ElementName=ScheduleEnabledBox}" Width="88" MaxLength="5" VerticalAlignment="Center" />
                                                <TextBox Grid.Column="3" Style="{StaticResource ScheduleInput}" Text="{Binding AllowedUntilText, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="{Binding EndAutomationName}" IsEnabled="{Binding IsChecked, ElementName=ScheduleEnabledBox}" Width="88" MaxLength="5" VerticalAlignment="Center" />
                                                <TextBox Grid.Column="4" Style="{StaticResource ScheduleInput}" Text="{Binding DailyLimitText, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="{Binding LimitAutomationName}" IsEnabled="{Binding IsChecked, ElementName=ScheduleEnabledBox}" Width="88" MaxLength="4" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="ScheduleErrorText" Grid.Row="3" Foreground="{DynamicResource ErrorTextBrush}" FontSize="11.5" TextWrapping="Wrap" MinHeight="18" />
                        <Grid Grid.Row="4" Margin="0,8,0,0"><Button x:Name="ScheduleBackButton" Content="Geri" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="ScheduleBack_Click" /><Button x:Name="ScheduleNextButton" Content="Devam et" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Click="ScheduleNext_Click" /></Grid>
                    </Grid>

                    <Grid x:Name="PreferencesPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock x:Name="PreferencesTitle" Text="Başlangıç ayarları" FontSize="27" FontWeight="SemiBold" />
                        <TextBlock x:Name="PreferencesDescription" Grid.Row="1" Text="İlk kullanım için temel tercihleri belirle." Foreground="{DynamicResource MutedTextBrush}" FontSize="13" Margin="0,9,0,0" />
                        <Grid Grid.Row="2" Margin="0,24,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock x:Name="DeviceNameLabel" Text="Cihaz adı" FontWeight="SemiBold" FontSize="12" /><TextBox x:Name="DeviceNameBox" Height="36" Padding="12,0" VerticalContentAlignment="Center" Margin="0,7,0,18" /><StackPanel x:Name="DailyLimitSection"><TextBlock x:Name="DailyLimitLabel" Text="Günlük süre" FontWeight="SemiBold" FontSize="12" /><ComboBox x:Name="DailyLimitBox" SelectedIndex="2" Margin="0,7,0,0"><ComboBoxItem Tag="60">1 saat / 1 hour</ComboBoxItem><ComboBoxItem Tag="120">2 saat / 2 hours</ComboBoxItem><ComboBoxItem Tag="180">3 saat / 3 hours</ComboBoxItem><ComboBoxItem Tag="240">4 saat / 4 hours</ComboBoxItem><ComboBoxItem Tag="300">5 saat / 5 hours</ComboBoxItem></ComboBox></StackPanel></StackPanel>
                            <StackPanel Grid.Column="2"><Border Style="{StaticResource FeatureBox}"><StackPanel><CheckBox x:Name="StartWithWindowsBox" Content="Windows ile başlat" IsChecked="True" /><TextBlock x:Name="StartWithWindowsHint" Text="Oturum açınca Kvieta arka planda hazır olur." Foreground="{DynamicResource MutedTextBrush}" FontSize="10.5" TextWrapping="Wrap" Margin="22,6,0,0" /></StackPanel></Border><Border Style="{StaticResource FeatureBox}" Margin="0,10,0,0"><StackPanel><CheckBox x:Name="DesktopShortcutBox" Content="Masaüstü kısayolu oluştur" IsChecked="True" /><TextBlock x:Name="DesktopShortcutHint" Text="Kvieta'ya masaüstünden hızlı erişim ekler." Foreground="{DynamicResource MutedTextBrush}" FontSize="10.5" TextWrapping="Wrap" Margin="22,6,0,0" /></StackPanel></Border><Border Style="{StaticResource FeatureBox}" Margin="0,10,0,0"><StackPanel><CheckBox x:Name="TrackingBox" Content="Yerel uygulama ölçümünü etkinleştir" IsChecked="True" /><TextBlock x:Name="TrackingHint" Text="Yalnız uygulama adı ve süre; pencere başlığı veya içerik yok." Foreground="{DynamicResource MutedTextBrush}" FontSize="10.5" TextWrapping="Wrap" Margin="22,6,0,0" /></StackPanel></Border><Border x:Name="PairManagerDeviceFeature" Style="{StaticResource FeatureBox}" Margin="0,10,0,0"><StackPanel><CheckBox x:Name="PairManagerDeviceBox" Content="Kurulumdan sonra güvenilir telefonu eşleştir" IsChecked="False" /><TextBlock x:Name="PairManagerDeviceHint" Text="İsteğe bağlıdır; PIN kurtarma yetkisi daha sonra da eklenebilir." Foreground="{DynamicResource MutedTextBrush}" FontSize="10.5" TextWrapping="Wrap" Margin="22,6,0,0" /></StackPanel></Border></StackPanel>
                        </Grid>
                        <Grid Grid.Row="3"><Button x:Name="PreferencesBackButton" Content="Geri" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="PreferencesBack_Click" /><Button x:Name="PreferencesNextButton" Content="Devam et" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Click="PreferencesNext_Click" /></Grid>
                    </Grid>

                    <Grid x:Name="PinPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock x:Name="PinTitle" Text="Yönetici PIN'i oluştur" FontSize="27" FontWeight="SemiBold" />
                        <TextBlock x:Name="PinDescription" Grid.Row="1" Text="Korumalı ayarları ve yönetici çıkışını güvenceye almak için 4–8 rakam belirle." Foreground="{DynamicResource MutedTextBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,9,0,0" />
                        <StackPanel Grid.Row="2" Width="360" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="PinLabel" Text="PIN" FontWeight="SemiBold" FontSize="12" />
                            <Grid Margin="0,7,0,16">
                                <PasswordBox x:Name="PinBox" MaxLength="8" Padding="12,8,46,8" PasswordChanged="Pin_Changed" />
                                <TextBox x:Name="VisiblePinBox" MaxLength="8" Padding="12,8,46,8" TextChanged="VisiblePin_Changed" Visibility="Collapsed" />
                                <Button x:Name="PinVisibilityButton" Width="34" Height="30" Padding="0" Margin="0,2,3,2" HorizontalAlignment="Right" VerticalAlignment="Stretch" Style="{StaticResource TitleBarButton}" Click="TogglePinVisibility_Click" ToolTip="PIN'i göster/gizle" AutomationProperties.Name="PIN'i göster/gizle">
                                    <Path Data="M2,12 C5,5 19,5 22,12 C19,19 5,19 2,12 M12,9 A3,3 0 1 1 11.99,9" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Button>
                            </Grid>
                            <TextBlock x:Name="PinRepeatLabel" Text="PIN'i tekrar gir" FontWeight="SemiBold" FontSize="12" />
                            <Grid Margin="0,7,0,0">
                                <PasswordBox x:Name="PinRepeatBox" MaxLength="8" Padding="12,8,46,8" PasswordChanged="Pin_Changed" />
                                <TextBox x:Name="VisiblePinRepeatBox" MaxLength="8" Padding="12,8,46,8" TextChanged="VisiblePin_Changed" Visibility="Collapsed" />
                                <Button x:Name="PinRepeatVisibilityButton" Width="34" Height="30" Padding="0" Margin="0,2,3,2" HorizontalAlignment="Right" VerticalAlignment="Stretch" Style="{StaticResource TitleBarButton}" Click="TogglePinRepeatVisibility_Click" ToolTip="PIN'i göster/gizle" AutomationProperties.Name="PIN'i göster/gizle">
                                    <Path Data="M2,12 C5,5 19,5 22,12 C19,19 5,19 2,12 M12,9 A3,3 0 1 1 11.99,9" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Button>
                            </Grid>
                            <TextBlock x:Name="PinErrorText" Foreground="{DynamicResource ErrorTextBrush}" FontSize="11" Margin="0,9,0,0" />
                        </StackPanel>
                        <Grid Grid.Row="3"><Button x:Name="PinBackButton" Content="Geri" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="PinBack_Click" /><Button x:Name="PinNextButton" Content="Devam et" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" IsEnabled="False" Click="PinNext_Click" /></Grid>
                    </Grid>

                    <Grid x:Name="RecoveryPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock x:Name="RecoveryTitle" Text="Kurtarma kodlarını kaydet" FontSize="27" FontWeight="SemiBold" />
                        <TextBlock x:Name="RecoveryDescription" Grid.Row="1" Text="PIN'ini unutursan bu tek kullanımlık kodlardan biriyle kurtarma yapabilirsin. Kodlar tekrar gösterilmeyecek." Foreground="{DynamicResource MutedTextBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,9,0,0" />
                        <Grid Grid.Row="2" Margin="0,20,0,16">
                            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBox x:Name="RecoveryCodesBox" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="13" Padding="14" VerticalScrollBarVisibility="Auto" />
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="CopyRecoveryCodesButton" Content="Kodları kopyala" Style="{StaticResource SecondaryButton}" Click="CopyRecoveryCodes_Click" Margin="0,0,8,0" />
                                <Button x:Name="SaveRecoveryCodesButton" Content="Dosyaya kaydet" Style="{StaticResource SecondaryButton}" Click="SaveRecoveryCodes_Click" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Margin="0,13,0,0">
                                <CheckBox x:Name="RecoveryAcknowledgementBox" Content="Kodları güvenli ve cihazdan ayrı bir yere kaydettim" Checked="RecoveryAcknowledgement_Changed" Unchecked="RecoveryAcknowledgement_Changed" />
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="3"><Button x:Name="RecoveryBackButton" Content="Geri" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="RecoveryBack_Click" /><Button x:Name="RecoveryNextButton" Content="Devam et" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" IsEnabled="False" Click="RecoveryNext_Click" /></Grid>
                    </Grid>

                    <Grid x:Name="SummaryPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock x:Name="SummaryTitle" Text="Kuruluma hazır" FontSize="27" FontWeight="SemiBold" />
                        <TextBlock x:Name="SummaryDescription" Grid.Row="1" Text="Seçimlerini kontrol et. Kur düğmesi yönetici izni isteyecek." Foreground="{DynamicResource MutedTextBrush}" FontSize="13" Margin="0,9,0,0" />
                        <Border Grid.Row="2" Style="{StaticResource SummaryBox}" Margin="0,24,0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="SummaryModeLabel" Text="Kullanım biçimi" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" /><TextBlock x:Name="SummaryDeviceLabel" Text="Cihaz" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,18,0,0" /><TextBlock x:Name="SummaryLimitLabel" Text="Günlük süre" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,18,0,0" /><TextBlock x:Name="SummaryOptionsLabel" Text="Seçenekler" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,18,0,0" /></StackPanel><StackPanel Grid.Column="1"><TextBlock x:Name="SummaryModeValue" FontWeight="SemiBold" /><TextBlock x:Name="SummaryDeviceValue" FontWeight="SemiBold" Margin="0,18,0,0" /><TextBlock x:Name="SummaryLimitValue" FontWeight="SemiBold" Margin="0,18,0,0" /><TextBlock x:Name="SummaryOptionsValue" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,18,0,0" /></StackPanel></Grid></Border>
                        <Grid Grid.Row="3"><Button x:Name="SummaryBackButton" Content="Geri" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="SummaryBack_Click" /><Button x:Name="InstallButton" Content="Kvieta'yı kur" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Click="Install_Click" /></Grid>
                    </Grid>

                    <Grid x:Name="InstallingPanel" Visibility="Collapsed"><StackPanel VerticalAlignment="Center"><TextBlock x:Name="InstallingEyebrow" Text="KVIETA KURULUYOR" Foreground="{DynamicResource PrimaryBrush}" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center" /><TextBlock x:Name="InstallingTitle" Text="Her şeyi senin için hazırlıyoruz." FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0" /><TextBlock x:Name="InstallingDescription" Text="Bu pencereyi kapatma. Windows yönetici izni isteyebilir." Foreground="{DynamicResource MutedTextBrush}" FontSize="13" HorizontalAlignment="Center" Margin="0,9,0,24" /><ProgressBar IsIndeterminate="True" Height="6" Width="420" Foreground="{DynamicResource PrimaryBrush}" Background="{DynamicResource PrimarySoftBrush}" /></StackPanel></Grid>

                    <Grid x:Name="ErrorPanel" Visibility="Collapsed"><StackPanel VerticalAlignment="Center"><Border Width="58" Height="58" Background="#3B211F" CornerRadius="18"><TextBlock Text="!" Foreground="#E18179" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock x:Name="ErrorTitle" Text="Kurulum tamamlanamadı." FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,0" /><TextBlock x:Name="ErrorDescription" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="560" Margin="0,10,0,22" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button x:Name="ErrorBackButton" Content="Geri dön" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="ErrorBack_Click" /><Button x:Name="RetryButton" Content="Tekrar dene" Style="{StaticResource PrimaryButton}" Click="Retry_Click" /></StackPanel></StackPanel></Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
