<Window x:Class="Otium.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Otium · Kontrol Merkezi" Width="1160" Height="730" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource BackgroundBrush}" Loaded="Window_Loaded" Closing="Window_Closing" Closed="Window_Closed">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6" CornerRadius="10" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="WindowDotStyle" TargetType="Button">
            <Setter Property="Width" Value="14" /><Setter Property="Height" Value="14" /><Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,7,0" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#2A2B24" /><Setter Property="FontSize" Value="10" /><Setter Property="FontWeight" Value="Bold" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Grid><Ellipse x:Name="Dot" Fill="{TemplateBinding Background}" /><TextBlock x:Name="Symbol" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" Margin="0,-1,0,0" /></Grid>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Symbol" Property="Opacity" Value="1" /></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" /><Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="6,2" /><Setter Property="Padding" Value="8,0" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="NavBorder" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" /></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource NavSelectedBrush}" /><Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                    <Setter Property="Width" Value="40" /><Setter Property="Height" Value="40" /><Setter Property="Margin" Value="0,2" /><Setter Property="Padding" Value="0" /><Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="HorizontalContentAlignment" Value="Center" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FlatListItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,1" /><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Row" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter /></Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource PrimarySoftBrush}" /></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="HeaderStatusButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Padding" Value="0,2,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="StatusBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="5" Height="5" Fill="{DynamicResource PrimaryBrush}" Margin="0,0,7,0" VerticalAlignment="Center" Visibility="Collapsed" />
                        <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" />
                    </StackPanel>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="StatusBorder" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasPendingChange}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                    <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Padding" Value="7,3" />
                    <Setter Property="Margin" Value="-7,0,0,0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PlanInputStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="CaretBrush" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource PrimarySoftBrush}" /><Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Height" Value="30" /><Setter Property="Padding" Value="6,3" /><Setter Property="TextAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
                <Border x:Name="InputBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                    <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="InputBorder" Property="Background" Value="{DynamicResource InputBrush}" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="InputBorder" Property="Background" Value="{DynamicResource PrimarySoftBrush}" /><Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SegmentItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" /><Setter Property="Padding" Value="10,0" /><Setter Property="Height" Value="26" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Segment" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Segment" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Segment" Property="Background" Value="{DynamicResource PrimaryBrush}" /><Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SegmentListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="0" /><Setter Property="Height" Value="28" /><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" /><Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PageTitleStyle" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="FontSize" Value="24" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
        <Style x:Key="PageDescriptionStyle" TargetType="TextBlock"><Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" /><Setter Property="Margin" Value="0,4,0,0" /></Style>
        <Style x:Key="CaptionStyle" TargetType="TextBlock"><Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" /></Style>
    </Window.Resources>

    <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition Height="*" /></Grid.RowDefinitions>

            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="14,0">
                    <TextBlock Text="{DynamicResource ControlCenter}" Foreground="{DynamicResource FaintTextBrush}" FontSize="10" HorizontalAlignment="Left" VerticalAlignment="Center" />
                    <TextBlock Text="Otium" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="−" Background="#D9AE50" Style="{StaticResource WindowDotStyle}" ToolTip="{DynamicResource Minimize}" Click="Minimize_Click" />
                        <Button Content="+" Background="#7E9A62" Style="{StaticResource WindowDotStyle}" ToolTip="{DynamicResource Maximize}" Click="Maximize_Click" />
                        <Button Content="×" Background="#E66A5F" Style="{StaticResource WindowDotStyle}" Margin="0" ToolTip="{DynamicResource Close}" Click="Close_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="184" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

                <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="58" /><RowDefinition Height="*" /><RowDefinition Height="44" /></Grid.RowDefinitions>
                        <Grid>
                            <StackPanel Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Border Width="30" Height="30" Background="{DynamicResource PrimaryBrush}" CornerRadius="8"><TextBlock Text="O" Foreground="{DynamicResource PrimaryForegroundBrush}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                <TextBlock Text="Otium" FontSize="16" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button x:Name="SidebarToggle" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Width="30" Height="30" Padding="0" Click="ToggleSidebar_Click" ToolTip="Menüyü daralt">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                        <Setter Property="Content" Value="‹" /><Setter Property="FontSize" Value="18" />
                                        <Style.Triggers><DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False"><Setter Property="Content" Value="›" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <ListBox Grid.Row="1" SelectedIndex="{Binding SelectedPageIndex, Mode=TwoWay}" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavItemStyle}" Margin="0,8,0,0">
                            <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Text="⌂" FontSize="16" Width="24" TextAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" /><TextBlock Text="{DynamicResource Today}" Margin="8,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" /></StackPanel></ListBoxItem>
                            <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Text="◷" FontSize="16" Width="24" TextAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" /><TextBlock Text="{DynamicResource Plan}" Margin="8,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" /></StackPanel></ListBoxItem>
                            <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Text="▦" FontSize="15" Width="24" TextAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" /><TextBlock Text="{DynamicResource Applications}" Margin="8,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" /></StackPanel></ListBoxItem>
                            <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Text="≋" FontSize="16" Width="24" TextAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" /><TextBlock Text="{DynamicResource History}" Margin="8,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" /></StackPanel></ListBoxItem>
                            <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Text="⚙" FontSize="15" Width="24" TextAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" /><TextBlock Text="{DynamicResource Settings}" Margin="8,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" /></StackPanel></ListBoxItem>
                        </ListBox>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="20,0" VerticalAlignment="Center"><Ellipse Fill="{DynamicResource SuccessBrush}" Width="6" Height="6" /><TextBlock Text="{DynamicResource OnlyThisDevice}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" /></StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions><RowDefinition Height="60" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                        <Grid Margin="24,0">
                            <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding DeviceName}" FontSize="15" FontWeight="SemiBold" /><Button Content="{Binding HeaderStatusText}" Style="{StaticResource HeaderStatusButtonStyle}" Click="PendingHeader_Click" /></StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="{DynamicResource SessionScreen}" Style="{StaticResource SecondaryButtonStyle}" Click="OpenCafeMode_Click" Margin="0,0,7,0" Padding="14,7" /><Button Content="{DynamicResource Save}" Style="{StaticResource PrimaryButtonStyle}" Click="Save_Click" MinWidth="78" Padding="14,7" /></StackPanel>
                        </Grid>
                    </Border>

                    <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedPageIndex, Mode=TwoWay}" Background="Transparent" BorderThickness="0">
                        <TabControl.Resources><Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed" /></Style></TabControl.Resources>

                        <TabItem>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <Grid Margin="24,20" MaxWidth="980">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <StackPanel><TextBlock Text="{DynamicResource Today}" Style="{StaticResource PageTitleStyle}" /><TextBlock Text="{DynamicResource TodayDescription}" Style="{StaticResource PageDescriptionStyle}" /></StackPanel>
                                    <Border Grid.Row="1" Style="{StaticResource PanelStyle}" Margin="0,18,0,0" Padding="22">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.6*" /><ColumnDefinition Width="55" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="{DynamicResource RemainingTime}" Style="{StaticResource SectionLabelStyle}" /><TextBlock Text="{Binding RemainingText}" FontSize="34" FontWeight="Light" Margin="0,7,0,17" /><ProgressBar Value="{Binding UsagePercent, Mode=OneWay}" Maximum="100" /><Grid Margin="0,8,0,0"><TextBlock Text="{Binding UsedTodayDisplayText}" Style="{StaticResource CaptionStyle}" /><TextBlock Text="{Binding TodayLimitDisplayText}" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Right" /></Grid></StackPanel>
                                            <Border Grid.Column="1" Width="1" Background="{DynamicResource BorderBrush}" HorizontalAlignment="Center" />
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{DynamicResource RightNow}" Style="{StaticResource SectionLabelStyle}" /><TextBlock Text="{Binding CurrentWindowStatus}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,7,0,0" /></StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Grid.Row="2" Style="{StaticResource PanelStyle}" Margin="0,12,0,0"><Grid Height="72"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="20,0"><TextBlock Text="{DynamicResource TodayLimit}" Style="{StaticResource CaptionStyle}" /><TextBlock Text="{Binding TodayLimitText}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel><Border Grid.Column="1" Background="{DynamicResource BorderBrush}" Margin="0,15" /><StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="20,0"><TextBlock Text="{DynamicResource AppRule}" Style="{StaticResource CaptionStyle}" /><TextBlock Text="{Binding RuleCount}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel><Border Grid.Column="3" Background="{DynamicResource BorderBrush}" Margin="0,15" /><StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="20,0"><TextBlock Text="{DynamicResource FullyBlocked}" Style="{StaticResource CaptionStyle}" /><TextBlock Text="{Binding BlockedAppCount}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel>
                                    </Grid></Border>
                                    <Border x:Name="PendingChangesCard" Grid.Row="3" Margin="0,12,0,0" Padding="18,14" CornerRadius="10" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Visibility="{Binding HasPendingChange, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource PrimarySoftBrush}" VerticalAlignment="Top"><TextBlock Text="◷" Foreground="{DynamicResource PrimaryBrush}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,22,0"><TextBlock Text="{DynamicResource PendingChangesTitle}" FontSize="14" FontWeight="SemiBold" /><ScrollViewer MaxHeight="88" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,6,0,0"><TextBlock Text="{Binding PendingChangeDetails}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="19" /></ScrollViewer></StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Right"><TextBlock Text="{DynamicResource AppliesAt}" Foreground="{DynamicResource FaintTextBrush}" FontSize="10" HorizontalAlignment="Right" /><TextBlock Text="{Binding PendingApplyTimeText}" Foreground="{DynamicResource PrimaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0" HorizontalAlignment="Right" /></StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <Grid Margin="24,20" MaxWidth="980"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid><StackPanel><TextBlock Text="{DynamicResource WeeklyPlan}" Style="{StaticResource PageTitleStyle}" /><TextBlock Text="{DynamicResource WeeklyPlanDescription}" Style="{StaticResource PageDescriptionStyle}" /></StackPanel><Button Content="{DynamicResource AddTemporaryAllowance}" Style="{StaticResource PrimaryButtonStyle}" Click="AddTemporaryAllowance_Click" HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="14,7" /></Grid>
                                    <Border Grid.Row="1" Style="{StaticResource PanelStyle}" Margin="0,18,0,0" ClipToBounds="True">
                                        <Grid><Grid.RowDefinitions><RowDefinition Height="32" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <Grid Margin="16,0"><Grid.ColumnDefinitions><ColumnDefinition Width="56" /><ColumnDefinition Width="*" /><ColumnDefinition Width="96" /><ColumnDefinition Width="96" /><ColumnDefinition Width="116" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{DynamicResource EnabledUpper}" Style="{StaticResource CaptionStyle}" FontSize="9" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{DynamicResource DayUpper}" Style="{StaticResource CaptionStyle}" FontSize="9" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="{DynamicResource StartUpper}" Style="{StaticResource CaptionStyle}" FontSize="9" VerticalAlignment="Center" TextAlignment="Center" /><TextBlock Grid.Column="3" Text="{DynamicResource EndUpper}" Style="{StaticResource CaptionStyle}" FontSize="9" VerticalAlignment="Center" TextAlignment="Center" /><TextBlock Grid.Column="4" Text="{DynamicResource DailyLimitUpper}" Style="{StaticResource CaptionStyle}" FontSize="9" VerticalAlignment="Center" TextAlignment="Center" />
                                            </Grid>
                                            <ItemsControl Grid.Row="1" ItemsSource="{Binding ScheduleRows}"><ItemsControl.ItemTemplate><DataTemplate>
                                                <Border Height="46" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="56" /><ColumnDefinition Width="*" /><ColumnDefinition Width="96" /><ColumnDefinition Width="96" /><ColumnDefinition Width="116" /></Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding DayName}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <TextBox Grid.Column="2" Style="{StaticResource PlanInputStyle}" Text="{Binding AllowedFrom, UpdateSourceTrigger=PropertyChanged}" Width="76" VerticalAlignment="Center" />
                                                    <TextBox Grid.Column="3" Style="{StaticResource PlanInputStyle}" Text="{Binding AllowedUntil, UpdateSourceTrigger=PropertyChanged}" Width="76" VerticalAlignment="Center" />
                                                    <TextBox Grid.Column="4" Style="{StaticResource PlanInputStyle}" Text="{Binding DailyLimitMinutes, UpdateSourceTrigger=LostFocus}" Width="76" VerticalAlignment="Center" />
                                                </Grid></Border>
                                            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                        </Grid>
                                    </Border>
                                    <Border Grid.Row="2" Style="{StaticResource PanelStyle}" Margin="0,14,0,0" Padding="18,15">
                                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <StackPanel><TextBlock Text="{DynamicResource TemporaryAllowances}" FontSize="14" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource TemporaryAllowancesDescription}" Style="{StaticResource CaptionStyle}" Margin="0,4,0,0" /></StackPanel>
                                            <ItemsControl Grid.Row="1" ItemsSource="{Binding TemporaryAllowances}" Margin="0,12,0,0"><ItemsControl.ItemTemplate><DataTemplate>
                                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="112" /><ColumnDefinition Width="112" /><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding DateText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding TimeText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="{Binding BonusText}" Foreground="{DynamicResource PrimaryBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" /><TextBlock Grid.Column="3" Text="{Binding Note}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" /><Button Grid.Column="4" Content="×" Tag="{Binding}" Width="28" Height="28" Padding="0" Style="{StaticResource SecondaryButtonStyle}" Click="RemoveTemporaryAllowance_Click" ToolTip="{DynamicResource Remove}" />
                                                </Grid></Border>
                                            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <Grid Margin="24,20" MaxWidth="980"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid><StackPanel><TextBlock Text="{DynamicResource Applications}" Style="{StaticResource PageTitleStyle}" /><TextBlock Text="{DynamicResource ApplicationsDescription}" Style="{StaticResource PageDescriptionStyle}" /></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"><Button Content="{DynamicResource Remove}" Style="{StaticResource SecondaryButtonStyle}" Click="RemoveApplication_Click" Margin="0,0,7,0" Padding="14,7" /><Button Content="{DynamicResource AddApplication}" Style="{StaticResource PrimaryButtonStyle}" Click="AddApplication_Click" Padding="14,7" /></StackPanel></Grid>
                                    <Border Grid.Row="1" Style="{StaticResource PanelStyle}" Margin="0,18,0,0" MinHeight="260" ClipToBounds="True"><Grid>
