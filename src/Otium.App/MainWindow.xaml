                                        <Border Grid.Row="11" Height="1" Background="{DynamicResource BorderBrush}" />
                                        <Grid Grid.Row="12" Margin="20,0"><Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="{DynamicResource AwarenessTracking}" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource AwarenessTrackingDescription}" Style="{StaticResource CaptionStyle}" Margin="0,3,14,0" TextWrapping="Wrap" /></StackPanel><CheckBox Grid.Column="1" IsChecked="{Binding AwarenessTrackingEnabled}" VerticalAlignment="Center" Content="{DynamicResource AwarenessTrackingConsent}" Checked="AwarenessTracking_Changed" Unchecked="AwarenessTracking_Changed" /></Grid>
