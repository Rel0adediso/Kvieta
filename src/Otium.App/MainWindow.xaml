                                    <Border Grid.Row="2" Style="{StaticResource PanelStyle}" Margin="0,11,0,0" Padding="20,13" Visibility="{Binding IsPersonalMode, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="{DynamicResource StrictPersonalMode}" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource StrictPersonalModeDescription}" Style="{StaticResource CaptionStyle}" Margin="0,3,12,0" TextWrapping="Wrap" /></StackPanel><CheckBox Grid.Column="1" IsChecked="{Binding StrictPersonalMode}" Content="{DynamicResource Enabled}" VerticalAlignment="Center" /></Grid><Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,12" /><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="{DynamicResource RelaxationDelay}" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource RelaxationDelayDescription}" Style="{StaticResource CaptionStyle}" Margin="0,3,12,0" TextWrapping="Wrap" /></StackPanel><ComboBox Grid.Column="1" ItemsSource="{Binding ChangeDelayOptions}" SelectedItem="{Binding ChangeDelay}" Height="32" VerticalAlignment="Center" /><StackPanel Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center" Visibility="{Binding HasPendingChange, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="{Binding PendingChangeText}" Foreground="{DynamicResource WarningBrush}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding PendingChangeDetails}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0" LineHeight="16" /><Button Content="{DynamicResource CancelPending}" Style="{StaticResource SecondaryButtonStyle}" Click="CancelPending_Click" HorizontalAlignment="Left" Padding="10,4" Margin="0,7,0,0" /></StackPanel></Grid></StackPanel></Border>
