                                                <TextBlock Grid.Column="2" Text="{Binding UsedText}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
