                                            <Border Grid.Row="2" Style="{StaticResource PanelStyle}" Padding="17,14"><StackPanel><TextBlock Text="{DynamicResource HistoryRecentEvents}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" /><ItemsControl ItemsSource="{Binding HistoryEvents}"><ItemsControl.ItemTemplate><DataTemplate><Grid Height="34"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="78" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Description}" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding TimeText}" FontSize="9" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </ScrollViewer>
                        </TabItem>

