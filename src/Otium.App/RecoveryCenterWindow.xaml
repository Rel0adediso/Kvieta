<Window x:Class="Otium.App.RecoveryCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="780" Height="610" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="Transparent" AllowsTransparency="True"
        ShowInTaskbar="False" Title="Otium · Recovery">
    <Window.Resources>
        <Style x:Key="CaptionStyle" TargetType="TextBlock"><Setter Property="FontSize" Value="10.5"/><Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/></Style>
    </Window.Resources>
    <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0"><TextBlock Text="Otium" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Content="×" Width="27" Height="27" Padding="0" HorizontalAlignment="Right" Style="{StaticResource SecondaryButtonStyle}" Click="Close_Click"/></Grid>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="34,26,34,30">
                    <TextBlock Text="{DynamicResource RecoveryCenterTitle}" FontSize="25" FontWeight="SemiBold"/>
                    <TextBlock Text="{DynamicResource RecoveryCenterDescription}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="19" Margin="0,7,0,20"/>

                    <Border Style="{StaticResource PanelStyle}" Padding="20,17" Margin="0,0,0,11">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource PrimarySoftBrush}" VerticalAlignment="Top"><TextBlock Text="1" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <StackPanel Grid.Column="1" Margin="0,0,24,0"><TextBlock Text="{DynamicResource TrustCurrentClockTitle}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource TrustCurrentClockDescription}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" LineHeight="17" Margin="0,6,0,0"/><TextBlock Text="{DynamicResource TrustCurrentClockRequirement}" Foreground="{DynamicResource WarningBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
                            <Button Grid.Column="2" Content="{DynamicResource TrustCurrentClockAction}" Style="{StaticResource SecondaryButtonStyle}" Padding="13,7" VerticalAlignment="Center" Click="TrustClock_Click"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource PanelStyle}" Padding="20,17" Margin="0,0,0,11">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource PrimarySoftBrush}" VerticalAlignment="Top"><TextBlock Text="2" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <StackPanel Grid.Column="1" Margin="0,0,24,0"><TextBlock Text="{DynamicResource RestoreSettingsTitle}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource RestoreSettingsDescription}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" LineHeight="17" Margin="0,6,0,0"/><TextBlock Text="{DynamicResource RestoreSettingsRequirement}" Foreground="{DynamicResource WarningBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
                            <Button Grid.Column="2" Content="{DynamicResource RestoreSettingsAction}" Style="{StaticResource SecondaryButtonStyle}" Padding="13,7" VerticalAlignment="Center" Click="RestoreSettings_Click"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource PanelStyle}" Padding="20,17">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource PrimarySoftBrush}" VerticalAlignment="Top"><TextBlock Text="3" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <StackPanel Grid.Column="1" Margin="0,0,24,0"><TextBlock Text="{DynamicResource RepairInstallationTitle}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource RepairInstallationDescription}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" LineHeight="17" Margin="0,6,0,0"/><TextBlock Text="{DynamicResource RepairInstallationRequirement}" Foreground="{DynamicResource WarningBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
                            <Button Grid.Column="2" Content="{DynamicResource RepairInstallationAction}" Style="{StaticResource SecondaryButtonStyle}" Padding="13,7" VerticalAlignment="Center" Click="RepairInstallation_Click"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="{DynamicResource RecoveryCenterPrivacyNote}" Foreground="{DynamicResource FaintTextBrush}" FontSize="10" TextWrapping="Wrap" LineHeight="16" Margin="2,15,2,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
