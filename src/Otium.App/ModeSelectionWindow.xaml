<Window x:Class="Otium.App.ModeSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="920" Height="455" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="Transparent" AllowsTransparency="True"
        ShowInTaskbar="True" Title="Otium">
    <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14">
        <Border.Resources>
            <Style x:Key="ModeCardStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}"><Setter Property="Padding" Value="22" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Stretch" /></Style>
            <Style x:Key="SelectedModeCardStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}"><Setter Property="Padding" Value="22" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Stretch" /></Style>
        </Border.Resources>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0"><TextBlock Text="Otium" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" /><Button Content="×" Width="27" Height="27" Padding="0" HorizontalAlignment="Right" Style="{StaticResource SecondaryButtonStyle}" Click="Cancel_Click" /></Grid>
            </Border>
            <Grid Grid.Row="1" Margin="34,26,34,30">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="{DynamicResource ChooseModeTitle}" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Grid.Row="1" Text="{DynamicResource ChooseModeDescription}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,7,0,22" />
                <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Button x:Name="AwarenessButton" Style="{StaticResource ModeCardStyle}" Click="Awareness_Click">
                        <StackPanel><TextBlock Text="{DynamicResource AwarenessMode}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource AwarenessModeDescription}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="19" Opacity="0.78" /><TextBlock Text="{DynamicResource AwarenessModeHint}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="11" Margin="0,18,0,0" TextWrapping="Wrap" Opacity="0.9" /></StackPanel>
                    </Button>
                    <Button x:Name="PersonalButton" Grid.Column="2" Style="{StaticResource ModeCardStyle}" Click="Personal_Click">
                        <StackPanel><TextBlock Text="{DynamicResource PersonalMode}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource PersonalModeDescription}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="19" Opacity="0.78" /><TextBlock Text="{DynamicResource PersonalModeHint}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="11" Margin="0,18,0,0" TextWrapping="Wrap" Opacity="0.9" /></StackPanel>
                    </Button>
                    <Button x:Name="ProtectedButton" Grid.Column="4" Style="{StaticResource ModeCardStyle}" Click="Protected_Click">
                        <StackPanel><TextBlock Text="{DynamicResource ProtectedMode}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource ProtectedModeDescription}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="19" Opacity="0.78" /><TextBlock Text="{DynamicResource ProtectedModeHint}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="11" Margin="0,18,0,0" TextWrapping="Wrap" Opacity="0.9" /></StackPanel>
                    </Button>
                </Grid>
                <TextBlock Grid.Row="3" Text="{DynamicResource ModeCanChangeLater}" Foreground="{DynamicResource FaintTextBrush}" FontSize="10" HorizontalAlignment="Center" Margin="0,18,0,0" />
            </Grid>
        </Grid>
    </Border>
</Window>
