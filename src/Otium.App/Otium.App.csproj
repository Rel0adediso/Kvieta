<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Otium</AssemblyName>
    <Product>Otium</Product>
    <Description>Local screen-time and session management for Windows</Description>
    <Version>1.0.0</Version>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>en-US</SatelliteResourceLanguages>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <DefineConstants Condition="'$(Configuration)' == 'Debug'">$(DefineConstants);OTIUM_DEVELOPMENT_BUILD</DefineConstants>
    <DefineConstants Condition="'$(Configuration)' == 'Release'">$(DefineConstants);OTIUM_PUBLIC_BUILD</DefineConstants>
    <InformationalVersion Condition="'$(Configuration)' == 'Debug'">$(Version)+development</InformationalVersion>
    <InformationalVersion Condition="'$(Configuration)' == 'Release'">$(Version)+public</InformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Otium.Core/Otium.Core.csproj" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.11" />
    <PackageReference Include="System.Management" Version="10.0.0" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <AssemblyMetadata Include="RepositoryCommit" Value="$(RepositoryCommit)" Condition="'$(RepositoryCommit)' != ''" />
    <AssemblyMetadata Include="RepositoryDirty" Value="$(RepositoryDirty)" Condition="'$(RepositoryDirty)' != ''" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../companion-web/dist/companion.js" LogicalName="Otium.Companion.js" />
  </ItemGroup>
</Project>
